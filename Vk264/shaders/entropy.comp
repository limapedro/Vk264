#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"
#include "bitstream.glsl"
#include "macroblock_syntax.glsl"

layout(local_size_x=8) in;

void appendBodies(uint first, uint count) {
    uint skipRun = 0u;
    for (uint mb = first; mb < first + count; ++mb) {
        uint length = mbSyntax[mb].y;
        if (length == 0u) {
            ++skipRun;
            continue;
        }
        if (length > mbBodyWords * 32u) {
            overflow = true;
            return;
        }
        skipRun = 0u;
        uint offset = mb * mbBodyWords;
        for (uint n = 0u; n < length / 32u; ++n) bits(mbBody[offset + n], 32);
        uint tail = length & 31u;
        if (tail != 0u) bits(mbBody[offset + length / 32u] >> (32u - tail), int(tail));
    }
    if (skipRun != 0u) ue(skipRun);
}

void main() {
    writeSlot = gl_GlobalInvocationID.x;
    if (writeSlot > pc.sliceCount) return;
    wordCount = packedWord = packedBytes = accumulator = pendingBits = zeroBytes = 0u;
    overflow = false;
    bool intra = idr();
    if (writeSlot == 0u) {
        prefix(intra);
    } else {
        uint slice = writeSlot - 1u;
        uint first = firstMb(slice), count = sliceLength(slice);
        uint activeRefs = pairedRows() ? slices[writeSlot].y & 31u : 1u;
        sliceHeader(first, intra, activeRefs);
        if (pairedRows()) {
            appendBodies(first, count);
            finishRbsp();
            if (packedBytes != 0u) flushWord();
            slices[writeSlot].x = overflow ? 0xffffffffu : wordCount;
            return;
        }
        uint skipRun = 0u;
        ivec2 leftTop = ivec2(0), leftBottom = ivec2(0);
        for (uint i = 0; i < count; ++i) {
            uint mb = first + i, base = mb * mbCoefficients;
            uint pattern = patterns(base);
            bool left = leftAvailable(mb, i), top = topAvailable(i);
            if (!intra) {
                if (!left) leftTop = leftBottom = ivec2(0);
                uint matchBase = 5u * mb;
                ivec2 mv = matches[matchBase].mv;
                bool partitioned = matches[matchBase].mode != 0u;
                ivec2 skipVector;
                ivec2 predictor = interPredictor(mb, top, left, leftTop, skipVector);
                if (!partitioned && pattern == 0u && all(equal(mv, skipVector))) {
                    ++skipRun;
                    leftTop = leftBottom = mv;
                    continue;
                }
                ue(skipRun);
                skipRun = 0u;
                ue(partitioned ? 3u : 0u); // P_8x8 or P_L0_16x16; one implicit reference
                if (partitioned) {
                    for (int p = 0; p < 4; ++p) ue(0u); // P_L0_8x8 sub_mb_type
                    ivec2 p0 = matches[matchBase + 1u].mv, p1 = matches[matchBase + 2u].mv;
                    ivec2 p2 = matches[matchBase + 3u].mv, p3 = matches[matchBase + 4u].mv;
                    writeMvd(p0, leftTop);
                    writeMvd(p1, p0);
                    // At the slice start A is unavailable for p2. B and C both reference list 0.
                    writeMvd(p2, medianMv(leftBottom, p0, p1));
                    writeMvd(p3, medianMv(p2, p1, p0));
                    leftTop = p1;
                    leftBottom = p3;
                } else {
                    writeMvd(mv, predictor);
                    leftTop = leftBottom = mv;
                }
            }
            writeMacroblock(base, pattern, intra, left, top, 0u, 0);
        }
        if (skipRun != 0u) ue(skipRun);
        finishRbsp();
    }
    // Annex B permits trailing_zero_8bits between NAL units. Align slots for GPU word copies.
    if (packedBytes != 0u) flushWord();
    slices[writeSlot].x = overflow ? 0xffffffffu : wordCount;
}
