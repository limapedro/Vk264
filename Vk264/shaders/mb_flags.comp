#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"
#include "bitstream.glsl"
#include "macroblock_syntax.glsl"

layout(local_size_x=64) in;
shared uvec3 refStats[64];
shared int qpAt[maxPairedSliceMbs];

void main() {
    uint slice = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
    uint first = firstMb(slice), count = sliceLength(slice);
    bool aq = pictureAq();
    uvec3 stats = uvec3(1u, 0u, 0u);
    for (uint local = lane; local < count; local += 64u) {
        uint mb = first + local;
        uint ref = referenceIndex(mb);
        uint pattern = patterns(mb * mbCoefficients);
        bool intra = isIntraMb(mb);
        bool isSkip = !intra && ref == 0u && pattern == 0u &&
            all(equal(matches[mb * 5u].mv, pairedPredictor(mb, local, 0, true)));
        mbSyntax[mb].x = pattern | (isSkip ? mbSkipFlag : 0u);
        if (aq) qpAt[local] = intra || pattern != 0u ? int(mbSyntax[mb].y) : -1;
        stats.x = max(stats.x, ref + 1u);
        stats.y += uint(ref > 0u);
        stats.z += uint(intra);
    }
    if (aq) {
        barrier();
        if (lane == 0u) {
            int previous = frameQp();
            for (uint local = 0u; local < count; ++local) {
                int qp = qpAt[local];
                int delta = qp < 0 ? 0 : qp - previous;
                previous += delta;
                // The proposed QPs are all within six of the slice QP.
                qpAt[local] = (previous << 7) | (delta & 127);
            }
        }
        barrier();
        for (uint local = lane; local < count; local += 64u) {
            mbSyntax[first + local].x |= uint(qpAt[local]) << 7u;
        }
    }
    refStats[lane] = stats;
    barrier();
    for (uint span = 32u; span > 0u; span >>= 1u) {
        if (lane < span) {
            uvec3 other = refStats[lane + span];
            refStats[lane] = uvec3(max(refStats[lane].x, other.x), refStats[lane].yz + other.yz);
        }
        barrier();
    }
    // The assembler's offset field is assigned after entropy coding.
    if (lane == 0u) slices[slice + 1u].y = (refStats[0].z << 15u) | (refStats[0].y << 5u) | refStats[0].x;
}
