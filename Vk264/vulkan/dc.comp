#version 450
#extension GL_GOOGLE_include_directive : require
#include "chroma_hadamard.glsl"
#include "quant_level.glsl"
layout(local_size_x = 64) in;

struct Block {
    int qp;
    uint multiplier, bias;
    int dequantScale;
    int source[16];
    int forward[16], inverse[16];
    int quantized[16], dequantized[16], chromaQuantized[4];
    int lumaNonzero, chromaNonzero;
    int chromaDcOnly[4], chromaBlocks[64];
    int chroma422DcOnly[8], chroma422Blocks[128];
};
layout(std430, binding = 0) buffer Corpus { Block blocks[]; };

int signed16(int value) { return bitfieldExtract(value, 0, 16); }

#include "luma_dc_math.glsl"

void main() {
    uint block = gl_GlobalInvocationID.x;
    if (block >= blocks.length()) return;
    ivec4 tmp[4];
    for (int i = 0; i < 4; ++i) {
        ivec4 inputRow;
        for (int j = 0; j < 4; ++j) inputRow[j] = blocks[block].source[4*i+j];
        ivec4 transformed = dcPass(inputRow);
        for (int j = 0; j < 4; ++j) tmp[j][i] = signed16(transformed[j]);
    }
    for (int i = 0; i < 4; ++i) {
        ivec4 transformed = dcPass(tmp[i]);
        for (int j = 0; j < 4; ++j) {
            blocks[block].forward[4*i+j] = signed16((transformed[j] + 1) >> 1);
            blocks[block].inverse[4*i+j] = signed16(transformed[j]);
        }
    }

    // The quantizers and dequantizer take separate copies of the input in the
    // fixture so each result can be compared directly with its C function.
    int shift = blocks[block].qp / 6 - 6;
    int lumaNonzero = 0, chromaNonzero = 0;
    for (int i = 0; i < 16; ++i) {
        int coefficient = blocks[block].source[i];
        int level = quantLevel(coefficient, blocks[block].multiplier, blocks[block].bias);
        blocks[block].quantized[i] = level;
        lumaNonzero |= level;
        if (i < 4) {
            blocks[block].chromaQuantized[i] = level;
            chromaNonzero |= level;
        }
        int product = coefficient * blocks[block].dequantScale;
        int restored = shift >= 0 ? product * (1 << shift) :
                       (product + (1 << (-shift - 1))) >> -shift;
        blocks[block].dequantized[i] = signed16(restored);
    }
    blocks[block].lumaNonzero = int(lumaNonzero != 0);
    blocks[block].chromaNonzero = int(chromaNonzero != 0);

    int d0 = blocks[block].source[0] + blocks[block].source[1];
    int d1 = blocks[block].source[2] + blocks[block].source[3];
    int d2 = blocks[block].source[0] - blocks[block].source[1];
    int d3 = blocks[block].source[2] - blocks[block].source[3];
    int scale = blocks[block].dequantScale << (blocks[block].qp / 6);
    ivec4 chroma = (ivec4(d0 + d1, d0 - d1, d2 + d3, d2 - d3) * scale) >> 5;
    for (int i = 0; i < 4; ++i) {
        blocks[block].chromaDcOnly[i] = signed16(chroma[i]);
        // The full-residual variant overwrites only the DC position of each block.
        blocks[block].chromaBlocks[16*i] = signed16(chroma[i]);
    }

    int input422[8], transformed422[8];
    for (int i = 0; i < 8; ++i) input422[i] = blocks[block].source[i];
    chromaHadamard2x4(input422, transformed422);
    for (int i = 0; i < 8; ++i) {
        int dc = signed16((transformed422[i] * scale + 32) >> 6);
        blocks[block].chroma422DcOnly[i] = dc;
        blocks[block].chroma422Blocks[16*i] = dc;
    }
}
