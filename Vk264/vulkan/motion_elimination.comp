#version 450
layout(local_size_x = 64) in;

const int maxCandidates = 96;
struct Fixture {
    int width, delta, threshold, blocks;
    int encodedDc[4];
    uint sums[2*maxCandidates + 8], motionCost[maxCandidates];
    int motion[maxCandidates], count;
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int delta = fixtures[fixture].delta;
    int blocks = fixtures[fixture].blocks;
    int count = 0;
    for (int i = 0; i < fixtures[fixture].width; ++i) {
        int ads = abs(fixtures[fixture].encodedDc[0] - int(fixtures[fixture].sums[i]))
                + int(fixtures[fixture].motionCost[i]);
        if (blocks == 2) ads += abs(fixtures[fixture].encodedDc[1] - int(fixtures[fixture].sums[i+delta]));
        if (blocks == 4) {
            ads += abs(fixtures[fixture].encodedDc[1] - int(fixtures[fixture].sums[i+8]))
                 + abs(fixtures[fixture].encodedDc[2] - int(fixtures[fixture].sums[i+delta]))
                 + abs(fixtures[fixture].encodedDc[3] - int(fixtures[fixture].sums[i+delta+8]));
        }
        if (ads < fixtures[fixture].threshold) fixtures[fixture].motion[count++] = i;
    }
    fixtures[fixture].count = count;
}
