#version 450
#extension GL_GOOGLE_include_directive : require
#include "parameter_types.glsl"
layout(local_size_x = 64) in;

const int refMax = 16, capacity = 1024;
const int sliceP = 0, sliceB = 1, sliceI = 2;
struct Weight {
    int enabled, denom, scale, offset;
};
struct Slice {
    int type, firstMb, ppsId, frameNumber;
    int mbaff, field, bottomField, idrId;
    int poc, deltaPocBottom, redundantCount, spatialDirect;
    int overrideRefs, refs0, refs1;
    int reorder[2];
    int order[2][refMax][2];
    Weight weights[refMax][3];
    int mmcoCount, mmcoDifference[refMax];
    int cabacInit, qpDelta, deblock, alphaOffset, betaOffset;
};
struct Fixture {
    int start, nalRef, alignCabac, weightedPred;
    Sps sps;
    Pps pps;
    Slice slice;
    uint bytes[capacity];
    int bitPosition, pointer, left;
    uint low, high;
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };
#include "bit_writer.glsl"

#define B(value) bsWrite1(f, w, uint(value))
#define UE(value) bsWrite(f, w, golombSize(uint(value)+1u), uint(value)+1u)
#define SE(value) bsWriteSe(f, w, value)

void reorderRefs(uint f, inout Writer w, Slice sh, int list, int count) {
    B(sh.reorder[list]);
    if (sh.reorder[list] == 0) return;
    for (int i = 0; i < count; ++i) {
        UE(sh.order[list][i][0]);
        UE(sh.order[list][i][1]);
    }
    UE(3);
}
void writeSliceHeader(uint f, inout Writer w, Sps sps, Pps pps, Slice sh, int nalRef) {
    int first = sh.firstMb;
    if (sh.mbaff != 0) {
        int x = first % sps.i_mb_width;
        int y = first / sps.i_mb_width;
        first = (2*x + sps.i_mb_width*(y & ~1) + (y & 1)) >> 1;
    }
    UE(first);
    UE(sh.type + 5);
    UE(sh.ppsId);
    bsWrite(f, w, sps.i_log2_max_frame_num, uint(sh.frameNumber) & ((1u << sps.i_log2_max_frame_num)-1u));
    if (sps.b_frame_mbs_only == 0) {
        B(sh.field);
        if (sh.field != 0) B(sh.bottomField);
    }
    if (sh.idrId >= 0) UE(sh.idrId);
    if (sps.i_poc_type == 0) {
        bsWrite(f, w, sps.i_log2_max_poc_lsb, uint(sh.poc) & ((1u << sps.i_log2_max_poc_lsb)-1u));
        if (pps.b_pic_order != 0 && sh.field == 0) SE(sh.deltaPocBottom);
    }
    if (pps.b_redundant_pic_cnt != 0) UE(sh.redundantCount);
    if (sh.type == sliceB) B(sh.spatialDirect);
    if (sh.type == sliceP || sh.type == sliceB) {
        B(sh.overrideRefs);
        if (sh.overrideRefs != 0) {
            UE(sh.refs0-1);
            if (sh.type == sliceB) UE(sh.refs1-1);
        }
    }
    if (sh.type != sliceI) reorderRefs(f, w, sh, 0, sh.refs0);
    if (sh.type == sliceB) reorderRefs(f, w, sh, 1, sh.refs1);
    fixtures[f].weightedPred = 0;
    if (pps.b_weighted_pred != 0 && sh.type == sliceP) {
        fixtures[f].weightedPred = int((sh.weights[0][0].enabled | sh.weights[0][1].enabled |
                                       sh.weights[0][2].enabled) != 0);
        UE(sh.weights[0][0].denom);
        if (sps.i_chroma_format_idc != 0) UE(sh.weights[0][1].denom);
        for (int i = 0; i < sh.refs0; ++i) {
            Weight luma = sh.weights[i][0];
            B(luma.enabled);
            if (luma.enabled != 0) {
                SE(luma.scale);
                SE(luma.offset);
            }
            if (sps.i_chroma_format_idc != 0) {
                int chroma = sh.weights[i][1].enabled | sh.weights[i][2].enabled;
                B(chroma);
                if (chroma != 0)
                    for (int j = 1; j < 3; ++j) {
                        SE(sh.weights[i][j].scale);
                        SE(sh.weights[i][j].offset);
                    }
            }
        }
    }
    if (nalRef != 0) {
        if (sh.idrId >= 0) { B(0); B(0); }
        else {
            B(sh.mmcoCount > 0);
            if (sh.mmcoCount > 0) {
                for (int i = 0; i < sh.mmcoCount; ++i) {
                    UE(1);
                    UE(sh.mmcoDifference[i]-1);
                }
                UE(0);
            }
        }
    }
    if (pps.b_cabac != 0 && sh.type != sliceI) UE(sh.cabacInit);
    SE(sh.qpDelta);
    if (pps.b_deblocking_filter_control != 0) {
        UE(sh.deblock);
        if (sh.deblock != 1) {
            SE(sh.alphaOffset >> 1);
            SE(sh.betaOffset >> 1);
        }
    }
}

void main() {
    uint f = gl_GlobalInvocationID.x;
    if (f >= fixtures.length()) return;
    int start = fixtures[f].start;
    Writer w = Writer(start & ~3, start, 64, 0u, 0u);
    bsRealign(f, w);
    writeSliceHeader(f, w, fixtures[f].sps, fixtures[f].pps, fixtures[f].slice, fixtures[f].nalRef);
    if (fixtures[f].alignCabac != 0) {
        int pad = w.left & 7;
        bsWrite(f, w, pad, (1u << pad)-1u);
        bsFlush(f, w);
    }
    fixtures[f].bitPosition = bsPos(w);
    fixtures[f].pointer = w.pointer;
    fixtures[f].left = w.left;
    fixtures[f].low = w.low;
    fixtures[f].high = w.high;
}
