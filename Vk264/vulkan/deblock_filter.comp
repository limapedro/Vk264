#version 450
#extension GL_GOOGLE_include_directive : require
#include "deblock_tables.glsl"
layout(local_size_x = 64) in;

const int strideMax = 48;
const int lumaV = 0, lumaH = 1, lumaMbaff = 2;
const int chromaV = 3, chromaH = 4, chroma422H = 5, chromaMbaff = 6;

struct Fixture {
    int stride, geometry, intra;
    int alpha, beta;
    int tc[4];
    int qp, offsetA, offsetB;
    uint strength[4];
    uint pixels[20 * strideMax];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

#define EDGE_PIXEL(index) fixtures[fixture].pixels[index]
#include "deblock_math.glsl"
#undef EDGE_PIXEL

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int stride = fixtures[fixture].stride;
    int geometry = fixtures[fixture].geometry;
    bool chroma = geometry >= chromaV;
    bool intra = fixtures[fixture].intra != 0;
    bool horizontalSamples = geometry == lumaV || geometry == chromaV;
    int xstride = horizontalSamples ? stride : chroma ? 2 : 1;
    int origin = 4*stride + 8;
    int height = (geometry == lumaMbaff || geometry == chromaMbaff) ? 8 :
                 (!chroma || horizontalSamples || geometry == chroma422H) ? 16 : 8;

    int alpha = fixtures[fixture].alpha;
    int beta = fixtures[fixture].beta;
    int tc[4] = fixtures[fixture].tc;
    int qp = fixtures[fixture].qp;
    if (qp >= 0) {
        int indexA = qp + fixtures[fixture].offsetA + 24;
        int indexB = qp + fixtures[fixture].offsetB + 24;
        alpha = alphaTable[indexA];
        beta = betaTable[indexB];
        uint combinedStrength = 0;
        for (int i = 0; i < 4; ++i) combinedStrength |= fixtures[fixture].strength[i];
        if (alpha == 0 || beta == 0 || (!intra && combinedStrength == 0)) return;
        if (!intra)
            for (int i = 0; i < 4; ++i)
                tc[i] = tcTable[indexA][fixtures[fixture].strength[i]] + int(chroma);
    }
    int segmentLength = height / 4;
    for (int i = 0; i < height; ++i) {
        int limit = tc[i / segmentLength];
        if (!intra && ((chroma && limit <= 0) || (!chroma && geometry != lumaMbaff && limit < 0)))
            continue;
        int center = origin + (horizontalSamples ? i : i*stride);
        if (chroma && !horizontalSamples) {
            // MBAFF chroma processes four field rows, two components per row.
            center = origin + (geometry == chromaMbaff ? i/2 : i)*stride;
            if (geometry == chromaMbaff) {
                filterLine(fixture, center + i%2, xstride, alpha, beta, tc[i/2], intra, true);
                continue;
            }
            filterLine(fixture, center + 1, xstride, alpha, beta, limit, intra, true);
        }
        filterLine(fixture, center, xstride, alpha, beta, limit, intra, chroma);
    }
}
