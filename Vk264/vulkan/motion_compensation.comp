#version 450
#extension GL_GOOGLE_include_directive : require
#include "motion_sampling.glsl"
layout(local_size_x = 64) in;

const int stride = 64, planeSize = stride*stride;
const int filterX = 5, filterY = 5, filterWidth = 53, filterHeight = 53;
const int verticalWidth = filterWidth + 5;
const int lumaStride = 24, chromaStride = 12, maxHeight = 16;
const int referenceOrigin = 24*stride + 24;

struct Fixture {
    int lumaX, lumaY, lumaWidth, lumaHeight;
    int chromaX, chromaY, chromaWidth, chromaHeight;
    int weighted, scale, denom, offset;
    int refPlane, refOffset, refStride;
    int prefiltered;
    uint source[planeSize], chroma[planeSize];
    uint hpel[3][planeSize];
    int scratch[verticalWidth];
    uint luma[lumaStride*maxHeight], refScratch[lumaStride*maxHeight];
    uint chromaU[chromaStride*maxHeight], chromaV[chromaStride*maxHeight];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };
shared int verticalTaps[filterHeight * verticalWidth];

int sixTap(int p0, int p1, int p2, int p3, int p4, int p5) {
    return p0 + p5 - 5*(p1 + p4) + 20*(p2 + p3);
}
int src(uint fixture, int position) { return int(fixtures[fixture].source[position]); }
int tapSource(uint fixture, int pos, int step) {
    return sixTap(src(fixture, pos - 2*step), src(fixture, pos - step), src(fixture, pos),
                  src(fixture, pos + step), src(fixture, pos + 2*step), src(fixture, pos + 3*step));
}
uint samplePlane(uint fixture, int plane, int position) {
    if (plane == 0) return fixtures[fixture].source[position];
    return fixtures[fixture].hpel[plane-1][position];
}
uint sampleChroma(uint fixture, int p, ivec4 weights) {
    ivec4 pixels = ivec4(fixtures[fixture].chroma[p], fixtures[fixture].chroma[p+2],
                         fixtures[fixture].chroma[p+stride], fixtures[fixture].chroma[p+stride+2]);
    ivec4 products = pixels * weights;
    return uint((products.x + products.y + products.z + products.w + 32) >> 6);
}

void filterReference(uint fixture, int lane) {
    for (int i = lane; i < filterHeight*verticalWidth; i += 64) {
        int p = (filterY + i/verticalWidth)*stride + filterX-2 + i%verticalWidth;
        int tap = tapSource(fixture, p, stride);
        verticalTaps[i] = tap;
        fixtures[fixture].hpel[1][p] = uint(clamp((tap + 16) >> 5, 0, 255));
        if (i/verticalWidth == filterHeight-1) fixtures[fixture].scratch[i%verticalWidth] = tap;
    }
    barrier();
    for (int i = lane; i < filterHeight*filterWidth; i += 64) {
        int y = i/filterWidth, x = i%filterWidth;
        int p = (filterY+y)*stride + filterX+x;
        int s = y*verticalWidth+x;
        int diagonal = sixTap(verticalTaps[s], verticalTaps[s+1], verticalTaps[s+2],
                              verticalTaps[s+3], verticalTaps[s+4], verticalTaps[s+5]);
        fixtures[fixture].hpel[0][p] = uint(clamp((tapSource(fixture, p, 1) + 16) >> 5, 0, 255));
        fixtures[fixture].hpel[2][p] = uint(clamp((diagonal + 512) >> 10, 0, 255));
    }
    memoryBarrierBuffer();
    barrier();
}

void main() {
    uint fixture = gl_WorkGroupID.x;
    if (fixture >= fixtures.length()) return;
    int lane = int(gl_LocalInvocationIndex);
    if (fixtures[fixture].prefiltered == 0) filterReference(fixture, lane);
    int mvx = fixtures[fixture].lumaX, mvy = fixtures[fixture].lumaY;
    int phase = ((mvy & 3) << 2) + (mvx & 3);
    int sourceOffset = referenceOrigin + (mvy >> 2)*stride + (mvx >> 2);
    int source1 = sourceOffset + ((mvy & 3) == 3 ? stride : 0);
    int source2 = sourceOffset + ((mvx & 3) == 3 ? 1 : 0);
    bool interpolate = (phase & 5) != 0;
    bool weighted = fixtures[fixture].weighted != 0;
    bool copyToScratch = interpolate || weighted;
    if (lane == 0) {
        fixtures[fixture].refPlane = copyToScratch ? -1 : reference0[phase];
        fixtures[fixture].refOffset = copyToScratch ? 0 : source1;
        fixtures[fixture].refStride = copyToScratch ? lumaStride : stride;
    }
    int width = fixtures[fixture].lumaWidth, height = fixtures[fixture].lumaHeight;
    for (int i = lane; i < width*height; i += 64) {
        int x = i%width, y = i/width;
        int sampleOffset = y*stride+x;
        uint value = samplePlane(fixture, reference0[phase], source1+sampleOffset);
        if (interpolate) value = (value + samplePlane(fixture, reference1[phase], source2+sampleOffset) + 1u) >> 1;
        if (weighted) value = uint(weightedPixel(int(value), fixtures[fixture].scale,
                                                fixtures[fixture].denom, fixtures[fixture].offset));
        int dest = y*lumaStride+x;
        fixtures[fixture].luma[dest] = value;
        if (copyToScratch) fixtures[fixture].refScratch[dest] = value;
    }

    int cmvx = fixtures[fixture].chromaX, cmvy = fixtures[fixture].chromaY;
    int horizontalFraction = cmvx & 7, verticalFraction = cmvy & 7;
    ivec4 weights = ivec4(8-horizontalFraction, horizontalFraction, 8-horizontalFraction, horizontalFraction)
                  * ivec4(8-verticalFraction, 8-verticalFraction, verticalFraction, verticalFraction);
    int origin = referenceOrigin + (cmvy >> 3)*stride + 2*(cmvx >> 3);
    width = fixtures[fixture].chromaWidth;
    height = fixtures[fixture].chromaHeight;
    for (int i = lane; i < width*height; i += 64) {
        int x = i%width, y = i/width;
        int p = origin + y*stride + 2*x;
        fixtures[fixture].chromaU[y*chromaStride+x] = sampleChroma(fixture, p, weights);
        fixtures[fixture].chromaV[y*chromaStride+x] = sampleChroma(fixture, p+1, weights);
    }
}
