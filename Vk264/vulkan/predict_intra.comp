#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

const int stride = 32;
const int origin = stride + 8;
struct Fixture {
    int width, height, mode;
    uint pixels[17 * stride];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

#include "predict_intra_math.glsl"

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int width = fixtures[fixture].width;
    int height = fixtures[fixture].height;
    int mode = fixtures[fixture].mode;
    predictIntra(fixture, width, height, mode);
}
