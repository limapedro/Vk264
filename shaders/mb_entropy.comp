#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"
#define WX_MACROBLOCK_BODY
#include "bitstream.glsl"
#include "macroblock_syntax.glsl"

layout(local_size_x=32) in;

void main() {
    uint mb = gl_GlobalInvocationID.x;
    if (mb >= pc.mbWidth * pc.mbHeight) return;
    // SHADER: an IDR picture is one whole-frame slice.  It has no skipped
    // macroblocks and encodes mb_type with a zero offset, unlike a P-slice.
    bool wholeIntra = idrWholeFrame();
    uint flags = mbSyntax[mb].x;
    if (!wholeIntra && (flags & mbSkipFlag) != 0u) {
        mbSyntax[mb].y = 0u;
        return;
    }

    writeSlot = mb;
    wordCount = pendingBits = accumulator = 0u;
    overflow = false;
    uint local = offsetInPair(mb);
    uint pattern;
    int qpDelta;
    bool left, top;
    if (wholeIntra) {
        pattern = patterns(mb * mbCoefficients);
        qpDelta = 0;
        left = leftAvailable(mb, mb);
        top = topAvailable(mb);
    } else {
        uint skipRun = 0u;
        for (uint i = 1u; i <= local && (mbSyntax[mb - i].x & mbSkipFlag) != 0u; ++i) ++skipRun;
        ue(skipRun);
        pattern = flags & 63u;
        qpDelta = mbQpDelta(flags);
        left = leftAvailable(mb, local);
        top = topAvailable(local);
    }
    bool intra = wholeIntra || isIntraMb(mb);
    if (!intra) {
        ue(0u); // P_L0_16x16
        uint ref = referenceIndex(mb);
        uint slice = mb / (2u * pc.mbWidth);
        uint activeRefs = slices[slice + 1u].y & 31u;
        if (activeRefs == 2u) bits(1u - ref, 1);
        else if (activeRefs > 2u) ue(ref);
        ivec2 predictor = pairedPredictor(mb, local, int(ref), false);
        writeMvd(matches[mb * 5u].mv, predictor);
    }
    writeMacroblock(mb * mbCoefficients, pattern, intra, left, top, wholeIntra ? 0u : 5u, qpDelta);
    if (pendingBits != 0u) {
        if (wordCount < mbBodyWords) mbBody[mb * mbBodyWords + wordCount] = accumulator;
        else overflow = true;
    }
    mbSyntax[mb].y = overflow ? 0xffffffffu : 32u * wordCount + pendingBits;
}
