#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"

layout(local_size_x=1) in;

void main() {
    uint total = 0u;
    uint olderBlocks = 0u;
    uint intraBlocks = 0u;
    uint selectedDepth = idr() ? 0u : 1u;
    bool overflow = false;
    for (uint i = 0u; i <= pc.sliceCount; ++i) {
        uint words = slices[i].x;
        if (pairedRows() && i > 0u) {
            olderBlocks += (slices[i].y >> 5u) & 1023u;
            intraBlocks += slices[i].y >> 15u;
            selectedDepth = max(selectedDepth, slices[i].y & 31u);
        }
        slices[i].y = total;
        overflow = overflow || words > pc.slotWords;
        total += min(words, pc.slotWords);
    }
    int qp = frameQp();
    outputWords[0] = 4u * total;
    outputWords[1] = uint(overflow);
    outputWords[2] = uint(qp) | (selectedDepth << 8u);
    outputWords[3] = (intraBlocks << 16u) | olderBlocks;

    if (pc.targetBits == 0u || overflow) return;
    // Reserve keyframe bits across the GOP. An IDR only updates the IDR
    // quantizer, so its entire cost cannot abruptly raise the next P-frame QP.
    int budget = int(pc.targetBits);
    int interFrames = int(pc.gop) - 1;
    int idrExtra = budget * min(5, interFrames / 8);
    bool intraBudget = separateIdrBudget();
    // Distribute the remainder too, so the per-picture targets sum to the GOP target.
    int share = idrExtra / max(1, interFrames);
    int remainder = idrExtra % max(1, interFrames);
    int allocation = intraBudget ? budget + idrExtra
                                : budget - share - int(int(pc.frameIndex % pc.gop) <= remainder && remainder != 0);
    // SHADER: a scene cut can spike one frame to ~20x the per-frame budget.
    // Without a bound the debt correction drives im to its floor and the
    // ABR controller then ramps QP by +2/frame for the rest of the GOP,
    // starving clean frames (measured: QP 33-34, PSNR 42.9 dB, VMAF 91.3 on
    // frames 218-227 of the game clip). Cap the per-frame correction so the
    // debt is repaid gradually instead of crushing the following pictures.
    int correction = clamp(rc.bitDebt / max(8, int(pc.fps) / 2),
                           -int(allocation) / 4, int(allocation) / 4);
    int aim = clamp(allocation - correction, max(1, allocation / 2), allocation * 3 / 2);
    int actual = int(32u * total);
    rc.bitDebt = clamp(rc.bitDebt + actual - allocation, -budget * 30, budget * 30);

    float rateRatio = float(max(1, actual)) / float(aim);
    int maxStep = intraBudget ? 4 : 2;
    int step = clamp(int(round((intraBudget ? 5.0 : 3.0) * log2(rateRatio))), -maxStep, maxStep);
    // At >=50 fps, easy/desktop-capture content can drive QP to 0 and waste
    // 4-6x the target bitrate for <1 VMAF gain (measured: 23.75 Mb/s -> 5.86 Mb/s
    // at VMAF 97.40 -> 96.69).  Gaming content naturally uses QP >= 18, so a
    // floor of 18 only constrains the pathological easy-content case.
    int offset = clamp(qp + step, pc.fps >= 50u ? 18 : 0, 51) - int(pc.initialQp);
    if (intraBudget) rc.idrQpOffset = offset;
    else rc.interQpOffset = offset;
}
