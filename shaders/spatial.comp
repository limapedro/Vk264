#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"
#include "transform.glsl"

layout(local_size_x=64) in;
const uint candidateCount = 23u;
shared uint costs[candidateCount];
shared ivec2 candidates[candidateCount];
shared uint shortlist[8];
shared int samples[256];
shared int blockSatd[128];
// SHADER: the 23x64 cheap candidate-SAD terms are computed by all 64 lanes
// instead of only the first 23, then summed in the original n order so the
// arithmetic and tie-break bits stay byte-identical.
shared int sadParts[candidateCount * 64u];

ivec2 seed(ivec2 mb) {
    mb = clamp(mb, ivec2(0), ivec2(pc.mbWidth, pc.mbHeight) - 1);
    return matches[motionSeedIndex(uint(mb.y) * pc.mbWidth + uint(mb.x))].mv;
}

ivec2 candidate(ivec2 mb, uint lane) {
    if (lane < 9u) {
        const ivec2 nearby[9] = ivec2[9](ivec2(0), ivec2(-1,0), ivec2(0,-1), ivec2(1,0),
            ivec2(0,1), ivec2(-1,-1), ivec2(1,-1), ivec2(-1,1), ivec2(1,1));
        return seed(mb + nearby[lane]);
    }
    if (lane == 9u) return ivec2(0);
    if (lane == 10u) {
        ivec2 a = seed(mb), b = seed(mb + ivec2(-1,0)), c = seed(mb + ivec2(0,-1));
        return min(max(a, b), max(min(a, b), c));
    }
    const ivec2 axial[4] = ivec2[4](ivec2(-2,0), ivec2(2,0), ivec2(0,-2), ivec2(0,2));
    uint cell = lane - 11u;
    ivec2 center = cell < 4u ? ivec2(-1,0) : (cell < 8u ? ivec2(0,-1) : ivec2(0));
    return seed(mb + center) + axial[cell & 3u];
}

ivec2 approximateMvp(ivec2 index) {
    bool paired = pairedRows();
    bool haveLeft = (uint(index.x) % (paired ? pc.mbWidth : sliceWidth)) != 0u;
    ivec2 left = haveLeft ? seed(index + ivec2(-1,0)) : ivec2(0);
    if (!paired || (uint(index.y) % pc.sliceRows) == 0u) return left;

    ivec2 above = seed(index + ivec2(0,-1));
    if (pc.mbWidth == 1u) return above;
    bool topRight = uint(index.x) + 1u < pc.mbWidth;
    ivec2 corner = topRight ? seed(index + ivec2(1,-1)) :
        (haveLeft ? seed(index + ivec2(-1,-1)) : ivec2(0));
    return medianMv(left, above, corner);
}

int motionCost(ivec2 mv, ivec2 predictor, int weight) {
    ivec2 diff = abs(mv - predictor);
    return weight * (findMSB(uint(diff.x + 1)) + findMSB(uint(diff.y + 1)));
}

int satd(ivec2 origin, ivec2 block, ivec2 mv) {
    ivec4 rows[4];
    for (int y = 0; y < 4; ++y) {
        ivec4 difference;
        for (int x = 0; x < 4; ++x) {
            ivec2 xy = block + ivec2(x, y);
            difference[x] = samples[xy.y * 16 + xy.x] - lumaPrediction(origin + xy, mv);
        }
        rows[y] = hadamard4(difference);
    }
    ivec4 total = ivec4(0);
    for (int x = 0; x < 4; ++x)
        total += abs(hadamard4(ivec4(rows[0][x], rows[1][x], rows[2][x], rows[3][x])));
    return (total.x + total.y + total.z + total.w) >> 1;
}

void main() {
    uint mb = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
    ivec2 index = ivec2(mb % pc.mbWidth, mb / pc.mbWidth);
    ivec2 origin = index * 16;
    uint finalists = pc.satdCandidates;
    if (finalists != 0u) {
        for (uint n = lane; n < 256u; n += 64u)
            samples[n] = srcPixel(0, origin + ivec2(n & 15u, n >> 4u));
    } else {
        ivec2 xy = 2 * ivec2(lane & 7u, lane >> 3u);
        samples[xy.y * 16 + xy.x] = srcPixel(0, origin + xy);
    }
    barrier();

    int weight = 2 + max(0, frameQp() - 24) / 4;
    ivec2 predictor = approximateMvp(index);
    if (lane < candidateCount) {
        int limit = hierarchicalMotionLimit();
        ivec2 mv = clamp(candidate(index, lane), -limit, limit);
        candidates[lane] = mv;
    }
    barrier();
    ivec2 sampleXy = 2 * ivec2(int(lane & 7u), int(lane >> 3u));
    for (uint c = 0u; c < candidateCount; ++c)
        sadParts[int(c * 64u + lane)] = abs(samples[sampleXy.y * 16 + sampleXy.x] -
                                            lumaPrediction(origin + sampleXy, candidates[c]));
    barrier();
    if (lane < candidateCount) {
        int sad = 0;
        for (uint n = 0u; n < 64u; ++n) sad += sadParts[lane * 64u + n];
        costs[lane] = 32u * uint(sad + motionCost(candidates[lane], predictor, weight)) + lane;
    }
    barrier();

    if (finalists == 0u) {
        if (lane == 0u) {
            uint best = 0xffffffffu;
            for (uint j = 0u; j < candidateCount; ++j) best = min(best, costs[j]);
            matches[mb * 5u] = MotionMatch(candidates[best & 31u], best >> 5u, 0u);
        }
        return;
    }

    // Shortlist unique vectors using the cheap sampled SAD, then test each
    // against all sixteen luma transform blocks at full resolution.
    if (lane == 0u) for (uint i = 0u; i < finalists; ++i) {
        uint best = 0xffffffffu;
        for (uint j = 0u; j < candidateCount; ++j) best = min(best, costs[j]);
        uint pick = best == 0xffffffffu ? shortlist[0] : best & 31u;
        shortlist[i] = pick;
        ivec2 mv = candidates[pick];
        for (uint j = 0u; j < candidateCount; ++j)
            if (all(equal(mv, candidates[j]))) costs[j] = 0xffffffffu;
    }
    barrier();
    for (uint item = lane; item < finalists * 16u; item += 64u) {
        uint rank = item >> 4u, block = item & 15u;
        ivec2 mv = candidates[shortlist[rank]];
        blockSatd[item] = satd(origin, 4 * ivec2(block & 3u, block >> 2u), mv);
    }
    barrier();
    if (lane == 0u) {
        uint best = 0xffffffffu;
        for (uint i = 0u; i < finalists; ++i) {
            int cost = motionCost(candidates[shortlist[i]], predictor, 2 * weight);
            for (uint j = 0u; j < 16u; ++j) cost += blockSatd[i*16u+j];
            best = min(best, 8u * uint(cost) + i);
        }
        matches[mb * 5u] = MotionMatch(candidates[shortlist[best & 7u]], best >> 3u, 0u);
    }
}
