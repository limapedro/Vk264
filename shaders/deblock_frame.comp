#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#define WX_RECONSTRUCTION_ACCESS coherent
#include "layout.glsl"
#include "transform.glsl"
#include "deblock_tables.glsl"

layout(local_size_x=128) in;
// Each set of 32 invocations owns a separate macroblock tile.
#define WX_DEBLOCK_TILES 4
#include "deblock_filter.glsl"

shared int segmentStrength[128];
shared uint teamActive[WX_DEBLOCK_TILES];

ivec3 innerWord(int word) {
    int plane = word < 64 ? 0 : (word < 80 ? 1 : 2);
    int columns = plane == 0 ? 4 : 2;
    int x = (word % columns) * 4;
    int y = (word % (columns * columns * 4)) / columns;
    return ivec3(plane, x, y);
}

void saveWord(uint mb, int plane, int x, int y) {
    reconstructed[reconWord(mb, plane, x, y)] = packWord(tileIndex(plane, x, y));
}

void main() {
    int qp = frameQp();
    bool aq = pictureAq();
    if (qp < 16 && !aq) return;
    int lane = int(gl_LocalInvocationIndex & 31u);
    int team = int(gl_LocalInvocationIndex >> 5u);
    // Each 32-lane team is its own subgroup; write the shared threshold table
    // from every team leader so no cross-team visibility is required.
    if ((gl_LocalInvocationIndex & 31u) == 0u) {
        thresholds[0] = deblockThresholds[qp];
        thresholds[1] = deblockThresholds[chromaQp(qp)];
    }

    // In skewed coordinates u=x+y and v=y, a macroblock depends on its
    // left, top and top-right neighbors. Each dependency reduces u or v.
    // Dispatch 4x4 tiles in u+v order, then wavefront the macroblocks within
    // each tile. Other teams on the same wave touch disjoint packed words.
    int uTiles = int((pc.mbWidth + pc.mbHeight + 2u) / 4u);
    int wave = int(pc.deblockWave);
    int maxDelta = int((pc.mbWidth + 2u) / 4u);
    int firstV = max(max(0, wave - uTiles + 1), (wave - maxDelta + 1) / 2);
    int tileV = firstV + int(gl_WorkGroupID.x);
    int tileU = wave - tileV;
    int y = tileV * 4 + team;
    int plane = lane < 16 ? 0 : (lane < 24 ? 1 : 2);
    int along = lane - (plane == 0 ? 0 : 8 * (plane + 1));
    int topColumns = plane == 0 ? 4 : 2;
    int topX = (along % topColumns) * 4;
    int topY = along / topColumns - 4;
    bool intra = idr();

    for (int localWave = 0; localWave < 7; ++localWave) {
        int localU = localWave - team;
        int x = tileU * 4 + localU - y;
        bool valid = localU >= 0 && localU < 4 && x >= 0 && x < int(pc.mbWidth) && y < int(pc.mbHeight);
        bool left = x != 0, top = y != 0;
        uint mb = uint(y * int(pc.mbWidth) + x);
        if (aq && valid && lane < 3) prepareEdgeThreshold(mb, lane, left, top);

        int teamBase = team * 32;
        bool vertical = lane < 16;
        int directionEdge = (lane & 15) / 4;
        bool available = directionEdge != 0 || (vertical ? left : top);
        // PERF: a subgroup vote replaces the activeSegments shared round-trip
        // and its two barriers. Each lane knows its own strength; the vote is
        // exactly the OR of all 32 strengths that activeSegments aggregated.
        int myStrength = valid && available
            ? strength(mb, lane & 3, directionEdge, vertical, intra) : 0;
        segmentStrength[teamBase + lane] = myStrength;
        bool needsFilter;
        if (gl_SubgroupSize == 32u) {
            // Fast path: each 32-lane team is exactly one hardware subgroup.
            needsFilter = subgroupAny(myStrength != 0);
        } else {
            // subgroupAny/subgroupBarrier only span the hardware subgroup,
            // which is 16 or 64 lanes on some devices.  A team then crosses
            // subgroup boundaries and a partial vote would make some lanes
            // read tile[] words nobody loaded.  Fall back to workgroup-wide
            // shared reduction and full barriers in that case.
            barrier();
            if (lane == 0) {
                uint any = 0u;
                for (int i = 0; i < 32; ++i)
                    if (segmentStrength[teamBase + i] != 0) { any = 1u; break; }
                teamActive[team] = any;
            }
            barrier();
            needsFilter = teamActive[team] != 0u;
        }
        if (needsFilter) {
            for (int i = lane; i < 96; i += 32) {
                ivec3 word = innerWord(i);
                loadWord(mb, word.x, word.y, word.z);
            }
            if (left) loadWord(mb, plane, -4, along);
            if (top) loadWord(mb, plane, topX, topY);
        }
        if (gl_SubgroupSize == 32u) subgroupBarrier(); else barrier();
        // Vertical edges are sequential within a row, then horizontal
        // edges are sequential within a column. Lanes own disjoint lines.
        int segment = along >> (plane == 0 ? 2 : 1);
        if (needsFilter) for (int edge = left ? 0 : 1; edge < 4; ++edge)
            filterEdgeWithStrength(plane, along, edge, true, segmentStrength[teamBase + 4*edge + segment]);
        if (gl_SubgroupSize == 32u) subgroupBarrier(); else barrier();
        if (needsFilter) for (int edge = top ? 0 : 1; edge < 4; ++edge)
            filterEdgeWithStrength(plane, along, edge, false, segmentStrength[teamBase + 16 + 4*edge + segment]);
        if (gl_SubgroupSize == 32u) subgroupBarrier(); else barrier();
        if (needsFilter) {
            if (left) saveWord(mb, plane, -4, along);
            if (top) saveWord(mb, plane, topX, topY);
            for (int i = lane; i < 96; i += 32) {
                ivec3 word = innerWord(i);
                saveWord(mb, word.x, word.y, word.z);
            }
        }
        memoryBarrierBuffer();
        barrier();
    }
}
