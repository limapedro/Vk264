#version 450
#extension GL_GOOGLE_include_directive : require
#include "layout.glsl"

layout(local_size_x=64) in;
shared int sampleY[64];
shared uint scores[64];
shared ivec2 candidates[64];
shared uint bestReference;

ivec2 olderCandidate(ivec2 latestMv, int reference, int shape) {
    int limit = int(pc.motionRadius);
    if (shape == 0) return ivec2(0);
    ivec2 displacement = shape == 1 ? latestMv : latestMv * (reference + 1);
    return clamp((displacement + 2) >> 2, -limit, limit);
}

uint bestLane(uint lane, uint score) {
    scores[lane] = score;
    barrier();
    for (uint span = 32u; span > 0u; span >>= 1u) {
        if (lane < span) scores[lane] = min(scores[lane], scores[lane + span]);
        barrier();
    }
    return scores[0] & 63u;
}

void main() {
    uint mb = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
    ivec2 origin = mbOrigin(mb, 0);
    ivec2 latestMv = matches[5u * mb].mv;
    ivec2 xy = origin + 2 * ivec2(lane & 7u, lane >> 3u);
    sampleY[lane] = srcPixel(0, xy);
    // Local check before touching older pictures. Near-perfect matches can
    // keep reference zero without pulling another picture into the cache.
    int currentError = abs(sampleY[lane] - lumaPrediction(xy, latestMv));
    scores[lane] = uint(currentError);
    barrier();
    for (uint span = 32u; span > 0u; span >>= 1u) {
        if (lane < span) scores[lane] += scores[lane + span];
        barrier();
    }
    if (lane == 0u) bestReference = scores[0];
    barrier();
    if (bestReference < 64u) return;

    uint refs = availableReferences();
    uint index = 1u + lane / 3u;
    uint score = ~0u;
    if (index < refs) {
        ivec2 mv = olderCandidate(latestMv, int(index), int(lane % 3u));
        candidates[lane] = mv;
        uint address = referenceOffset(index);
        uint sad = 0u;
        for (int y = 0; y < 8; y += 2) for (int x = 0; x < 8; x += 2) {
            ivec2 p = origin + 2 * ivec2(x, y);
            sad += uint(abs(sampleY[y * 8 + x] - refPixelAt(0, p + mv, address)));
        }
        score = 64u * (sad + uint(findMSB(index + 1u))) + lane;
    }
    uint winner = bestLane(lane, score);
    ivec2 seed = candidates[winner];
    if (lane == 0u) bestReference = 1u + winner / 3u;
    barrier();

    // Recheck the best older picture on the same sample positions as reference
    // zero and refine its full-pixel vector. Older luma uses integer positions.
    uint address = referenceOffset(bestReference);
    score = ~0u;
    if (lane <= 9u) {
        int limit = int(pc.motionRadius);
        ivec2 mv = clamp(seed + ivec2(lane % 3u, lane / 3u) - 1, -limit, limit);
        candidates[lane] = mv;
        uint sad = 0u;
        for (uint i = 0u; i < 64u; ++i) {
            ivec2 p = origin + 2 * ivec2(i & 7u, i >> 3u);
            int predicted = lane == 9u ? lumaPrediction(p, latestMv) : refPixelAt(0, p + mv, address);
            sad += uint(abs(sampleY[i] - predicted));
        }
        // Favor the nearby reference when the predicted errors are close.
        if (lane != 9u) sad += 12u + 3u * uint(findMSB(bestReference + 1u));
        score = sad * 64u + lane;
    }
    winner = bestLane(lane, score);
    if (lane == 0u && winner != 9u) {
        matches[5u * mb].mv = candidates[winner] * 4;
        matches[5u * mb].mode = bestReference << 1u;
    }
}
