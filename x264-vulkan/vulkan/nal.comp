#version 450
layout(local_size_x = 64) in;

// Each descriptor owns a nonoverlapping input and output span in the same buffer.
// Header sits at the front, followed by 12 words per descriptor and then byte values.
const uint fields = 12u;
layout(std430, binding = 0) buffer Corpus { uint words[]; };

uint nalEscape(uint dst, uint src, uint count) {
    uint zeros = 0;
    for (uint i = 0; i < count; ++i) {
        uint byteValue = words[src+i];
        if (byteValue <= 3u && zeros >= 2u) {
            words[dst++] = 3u;
            zeros = 0u;
        }
        words[dst++] = byteValue;
        zeros = byteValue == 0u ? zeros+1u : 0u;
    }
    return dst;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= words[0]) return;
    uint entry = 1u + fields*index;
    uint src = words[entry];
    uint count = words[entry+1u];
    uint start = words[entry+2u];
    uint dst = start;
    if (words[entry+8u] != 0u) {
        // Public form of nal_escape without a prefix or a NAL header.
        words[entry+9u] = nalEscape(dst, src, count) - start;
        return;
    }
    bool annexB = words[entry+3u] != 0u;
    if (annexB) {
        if (words[entry+4u] != 0u) words[dst++] = 0u;
        words[dst++] = 0u;
        words[dst++] = 0u;
        words[dst++] = 1u;
    } else {
        dst += 4u;
    }
    words[dst++] = (words[entry+5u] << 5) | words[entry+6u];
    dst = nalEscape(dst, src, count);
    uint size = dst-start;
    uint previousPadding = words[entry+7u];
    uint padding = previousPadding;
    if (words[entry+10u] != 0u) {
        padding = uint(max(int(count+previousPadding+5u)-int(size), 0));
        for (uint i = 0; i < padding; ++i) words[dst+i] = 0u;
        size += padding;
    }
    if (!annexB) {
        uint length = size-4u;
        for (uint i = 0; i < 4; ++i) words[start+i] = (length >> (24u-8u*i)) & 255u;
    }
    words[entry+9u] = size;
    words[entry+11u] = padding;
}
