#version 450
#extension GL_GOOGLE_include_directive : require
#include "parameter_types.glsl"
layout(local_size_x = 64) in;

struct Fixture {
    int kind, bitDepth, start, position;
    Sps sps;
    Pps pps;
    uint scaling[8][64];
    uint bytes[1024];
};
layout(std430, binding = 0) buffer Corpus {
    int defaults[8][64];
    int scan4[16], scan8[64];
    Fixture fixtures[];
};
#include "bit_writer.glsl"

const ivec2 sar[16] = ivec2[16](ivec2(1,1), ivec2(12,11), ivec2(10,11), ivec2(16,11),
                              ivec2(40,33), ivec2(24,11), ivec2(20,11), ivec2(32,11),
                              ivec2(80,33), ivec2(18,11), ivec2(15,11), ivec2(64,33),
                              ivec2(160,99), ivec2(4,3), ivec2(3,2), ivec2(2,1));
#define B(value) bsWrite1(f, w, uint(value))
#define W(length, value) bsWrite(f, w, length, uint(value))
#define UE(value) bsWriteUeBig(f, w, uint(value))
#define SE(value) bsWriteSe(f, w, value)

int scalingValue(uint f, int list, int pos) {
    return int(fixtures[f].scaling[list][list < 4 ? scan4[pos] : scan8[pos]]);
}
void writeScalingList(uint f, inout Writer w, int list) {
    int length = list < 4 ? 16 : 64;
    int parent = (list&2) != 0 ? list-2 : -1;
    bool sameDefault = true, sameJvt = true;
    for (int i = 0; i < length; ++i) {
        int v = int(fixtures[f].scaling[list][i]);
        int jvt = defaults[list][i];
        sameDefault = sameDefault && v == (parent < 0 ? jvt : int(fixtures[f].scaling[parent][i]));
        sameJvt = sameJvt && v == jvt;
    }
    B(!sameDefault);
    if (sameDefault) return;
    if (sameJvt) {
        SE(-8);
        return;
    }
    int run = length;
    while (run > 1 && scalingValue(f, list, run-1) == scalingValue(f, list, run-2)) --run;
    if (run < length) {
        int stop = bitfieldExtract(-scalingValue(f, list, run), 0, 8);
        if (length-run < golombSize(signedCodeword(stop))) run = length;
    }
    int previous = 8;
    for (int i = 0; i < run; ++i) {
        int value = scalingValue(f, list, i);
        SE(bitfieldExtract(value-previous, 0, 8));
        previous = value;
    }
    if (run < length) SE(bitfieldExtract(-scalingValue(f, list, run), 0, 8));
}

void writeVui(uint f, inout Writer w, SpsVui vui) {
    B(vui.b_aspect_ratio_info_present);
    if (vui.b_aspect_ratio_info_present != 0) {
        int idc = 255;
        for (int i = 0; i < 16; ++i)
            if (sar[i] == ivec2(vui.i_sar_width, vui.i_sar_height)) {
                idc = i+1;
                break;
            }
        W(8, idc);
        if (idc == 255) {
            W(16, vui.i_sar_width);
            W(16, vui.i_sar_height);
        }
    }
    B(vui.b_overscan_info_present);
    if (vui.b_overscan_info_present != 0) B(vui.b_overscan_info);
    B(vui.b_signal_type_present);
    if (vui.b_signal_type_present != 0) {
        W(3, vui.i_vidformat);
        B(vui.b_fullrange);
        B(vui.b_color_description_present);
        if (vui.b_color_description_present != 0) {
            W(8, vui.i_colorprim);
            W(8, vui.i_transfer);
            W(8, vui.i_colmatrix);
        }
    }
    B(vui.b_chroma_loc_info_present);
    if (vui.b_chroma_loc_info_present != 0) {
        UE(vui.i_chroma_loc_top);
        UE(vui.i_chroma_loc_bottom);
    }
    B(vui.b_timing_info_present);
    if (vui.b_timing_info_present != 0) {
        bsWrite32(f, w, vui.i_num_units_in_tick);
        bsWrite32(f, w, vui.i_time_scale);
        B(vui.b_fixed_frame_rate);
    }
    B(vui.b_nal_hrd_parameters_present);
    if (vui.b_nal_hrd_parameters_present != 0) {
        SpsHrd hrd = vui.hrd;
        UE(hrd.i_cpb_cnt-1);
        W(4, hrd.i_bit_rate_scale);
        W(4, hrd.i_cpb_size_scale);
        UE(hrd.i_bit_rate_value-1);
        UE(hrd.i_cpb_size_value-1);
        B(hrd.b_cbr_hrd);
        W(5, hrd.i_initial_cpb_removal_delay_length-1);
        W(5, hrd.i_cpb_removal_delay_length-1);
        W(5, hrd.i_dpb_output_delay_length-1);
        W(5, hrd.i_time_offset_length);
    }
    B(vui.b_vcl_hrd_parameters_present);
    if ((vui.b_nal_hrd_parameters_present | vui.b_vcl_hrd_parameters_present) != 0) B(0);
    B(vui.b_pic_struct_present);
    B(vui.b_bitstream_restriction);
    if (vui.b_bitstream_restriction != 0) {
        B(vui.b_motion_vectors_over_pic_boundaries);
        UE(vui.i_max_bytes_per_pic_denom);
        UE(vui.i_max_bits_per_mb_denom);
        UE(vui.i_log2_max_mv_length_horizontal);
        UE(vui.i_log2_max_mv_length_vertical);
        UE(vui.i_num_reorder_frames);
        UE(vui.i_max_dec_frame_buffering);
    }
}

void writeSps(uint f, inout Writer w, Sps sps, int bitDepth) {
    W(8, sps.i_profile_idc);
    B(sps.b_constraint_set0);
    B(sps.b_constraint_set1);
    B(sps.b_constraint_set2);
    B(sps.b_constraint_set3);
    W(4, 0);
    W(8, sps.i_level_idc);
    UE(sps.i_id);
    if (sps.i_profile_idc >= 100) {
        UE(sps.i_chroma_format_idc);
        if (sps.i_chroma_format_idc == 3) B(0);
        UE(bitDepth-8);
        UE(bitDepth-8);
        B(sps.b_qpprime_y_zero_transform_bypass);
        B(sps.b_avcintra_hd);
        if (sps.b_avcintra_hd != 0) {
            writeScalingList(f, w, 0);
            writeScalingList(f, w, 2);
            writeScalingList(f, w, 2);
            B(0); B(0); B(0);
            writeScalingList(f, w, 4);
            B(0);
            if (sps.i_chroma_format_idc == 3) {
                writeScalingList(f, w, 6);
                B(0);
                writeScalingList(f, w, 6);
                B(0);
            }
        }
    }
    UE(sps.i_log2_max_frame_num-4);
    UE(sps.i_poc_type);
    if (sps.i_poc_type == 0) UE(sps.i_log2_max_poc_lsb-4);
    UE(sps.i_num_ref_frames);
    B(sps.b_gaps_in_frame_num_value_allowed);
    UE(sps.i_mb_width-1);
    int interlaced = int(sps.b_frame_mbs_only == 0);
    UE((sps.i_mb_height >> interlaced)-1);
    B(sps.b_frame_mbs_only);
    if (interlaced != 0) B(sps.b_mb_adaptive_frame_field);
    B(sps.b_direct8x8_inference);
    B(sps.b_crop);
    if (sps.b_crop != 0) {
        int h = int(sps.i_chroma_format_idc == 1 || sps.i_chroma_format_idc == 2);
        int v = int(sps.i_chroma_format_idc == 1) + interlaced;
        UE(sps.crop.i_left >> h);
        UE(sps.crop.i_right >> h);
        UE(sps.crop.i_top >> v);
        UE(sps.crop.i_bottom >> v);
    }
    B(sps.b_vui);
    if (sps.b_vui != 0) writeVui(f, w, sps.vui);
}

void writePps(uint f, inout Writer w, Sps sps, Pps pps, int bitDepth) {
    UE(pps.i_id);
    UE(pps.i_sps_id);
    B(pps.b_cabac);
    B(pps.b_pic_order);
    UE(pps.i_num_slice_groups-1);
    UE(pps.i_num_ref_idx_l0_default_active-1);
    UE(pps.i_num_ref_idx_l1_default_active-1);
    B(pps.b_weighted_pred);
    W(2, pps.b_weighted_bipred);
    SE(pps.i_pic_init_qp-26-6*(bitDepth-8));
    SE(pps.i_pic_init_qs-26-6*(bitDepth-8));
    SE(pps.i_chroma_qp_index_offset);
    B(pps.b_deblocking_filter_control);
    B(pps.b_constrained_intra_pred);
    B(pps.b_redundant_pic_cnt);
    bool scaling = sps.b_avcintra_hd == 0 && sps.i_cqm_preset != 0;
    if (pps.b_transform_8x8_mode != 0 || scaling) {
        B(pps.b_transform_8x8_mode);
        B(scaling);
        if (scaling) {
            writeScalingList(f, w, 0);
            writeScalingList(f, w, 2);
            if (sps.b_avcintra_4k != 0) {
                writeScalingList(f, w, 2);
                B(0); B(0); B(0);
            } else {
                B(0);
                writeScalingList(f, w, 1);
                writeScalingList(f, w, 3);
                B(0);
            }
            if (pps.b_transform_8x8_mode != 0) {
                writeScalingList(f, w, 4);
                if (sps.b_avcintra_4k != 0) B(0);
                else writeScalingList(f, w, 5);
                if (sps.i_chroma_format_idc == 3) {
                    writeScalingList(f, w, 6);
                    writeScalingList(f, w, 7);
                    B(0); B(0);
                }
            }
        }
        SE(pps.i_chroma_qp_index_offset);
    }
}

void main() {
    uint f = gl_GlobalInvocationID.x;
    if (f >= fixtures.length()) return;
    int start = fixtures[f].start;
    Writer w = Writer(start & ~3, start, 64, 0u, 0u);
    bsRealign(f, w);
    if (fixtures[f].kind == 0) writeSps(f, w, fixtures[f].sps, fixtures[f].bitDepth);
    else writePps(f, w, fixtures[f].sps, fixtures[f].pps, fixtures[f].bitDepth);
    bsTrailing(f, w);
    bsFlush(f, w);
    fixtures[f].position = w.pointer;
}
