// Header: dimensions, then word offsets for source, four luma reference
// planes, two chroma reference planes and macroblock outputs.
const int frameHeader = 8, resultWords = 98, border = 32;
int frameWidth() { return int(frameWords[0]); }
int frameHeight() { return int(frameWords[1]); }
int referenceStride() { return frameWidth()+2*border; }
int sampleByte(uint base, int index) {
    return int((frameWords[base+uint(index/4)] >> (8*(index&3))) & 255u);
}
uint resultIndex(uint mb) { return frameWords[7]+mb*resultWords; }
ivec2 vectorAt(int mb) {
    uint p = resultIndex(uint(max(0, mb)));
    return mb < 0 ? ivec2(0) : ivec2(frameWords[p], frameWords[p+1]);
}
