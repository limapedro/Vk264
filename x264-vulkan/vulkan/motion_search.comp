#ifndef FRAME_MOTION
int chromaSample(uint fixture, int plane, int position) {
    return int(bitfieldExtract(fixtures[fixture].chromaReference[plane][position/4], 8*(position%4), 8));
}
int lumaResidual(Search search, Reference ref, int x, int y) {
    int p = y*stride+x;
    int value = int(fixtures[search.fixture].reference[ref.plane0][ref.start0+p]);
    if (ref.plane1 >= 0)
        value = (value + int(fixtures[search.fixture].reference[ref.plane1][ref.start1+p]) + 1) >> 1;
    if (search.weighted) value = weightedPixel(value, search.scale, search.denom, search.offset);
    return int(fixtures[search.fixture].source[y*16+x]) - value;
}
int chromaResidual(Search search, Reference ref, int component, ivec4 weights, int x, int y) {
    uint f = search.fixture;
    int value;
    if (search.chromaMode == 3) {
        int p = y*stride+x, base = component*4;
        value = chromaSample(f, base+ref.plane0, ref.start0+p);
        if (ref.plane1 >= 0) value = (value + chromaSample(f, base+ref.plane1, ref.start1+p) + 1) >> 1;
    } else {
        int p = ref.start0+y*stride+2*x+component;
        value = (weights.x*chromaSample(f, 0, p) + weights.y*chromaSample(f, 0, p+2)
               + weights.z*chromaSample(f, 0, p+stride) + weights.w*chromaSample(f, 0, p+stride+2) + 32) >> 6;
    }
    if (fixtures[f].chromaWeights[component][0] != 0)
        value = weightedPixel(value, fixtures[f].chromaWeights[component][1],
                              fixtures[f].chromaWeights[component][2], fixtures[f].chromaWeights[component][3]);
    return int(fixtures[f].chromaSource[component][y*16+x]) - value;
}
int residual(Search search, Reference ref, int component, ivec4 weights, int x, int y) {
    if (component < 0) return lumaResidual(search, ref, x, y);
    return chromaResidual(search, ref, component, weights, x, y);
}
#else
int frameLuma(Reference ref, int offset) {
    uint base = frameWords[3], planeWords = frameWords[4];
    int value = sampleByte(base+uint(ref.plane0)*planeWords, ref.start0+offset);
    if (ref.plane1 >= 0)
        value = (value + sampleByte(base+uint(ref.plane1)*planeWords, ref.start1+offset) + 1) >> 1;
    return value;
}
int residual(Search search, Reference ref, int component, ivec4 weights, int x, int y) {
    int src = search.sourceOrigin + y*search.sourceStride+x;
    return sampleByte(frameWords[2], src) - frameLuma(ref, y*search.referenceStride+x);
}
#ifdef FRAME_MOTION_PARALLEL
uint packedSamples(uint base, int index) {
    uint word = base+uint(index/4), shift = uint(index&3)*8u;
    uint a = frameWords[word];
    return shift == 0u ? a : (a >> shift) | (frameWords[word+1u] << (32u-shift));
}

uint packedReferenceLuma(Reference ref, int offset) {
    uint base = frameWords[3], planeWords = frameWords[4];
    uint a = packedSamples(base+uint(ref.plane0)*planeWords, ref.start0+offset);
    if (ref.plane1 < 0) return a;
    uint b = packedSamples(base+uint(ref.plane1)*planeWords, ref.start1+offset);
    return (a|b)-(((a^b)>>1u)&0x7f7f7f7fu);
}

ivec4 unpackLuma(uint four) {
    return ivec4((uvec4(four)>>uvec4(0,8,16,24))&255u);
}

uint absoluteBytePairs(uint a, uint b) {
    // Guard bits isolate the two byte subtractions in separate 16-bit lanes.
    uint difference = ((a & 0x00ff00ffu) | 0x01000100u) - (b & 0x00ff00ffu);
    uint negative = ((~difference >> 8u) & 0x00010001u)*255u;
    return ((difference ^ negative)+(negative & 0x00010001u)) & 0x00ff00ffu;
}

int partialLumaSad(Search search, Reference ref, uint lane, uint lanes) {
    uint sum = 0u;
    for (uint word = lane; word < 64u; word += lanes) {
        int x = int((word&3u)*4u), y = int(word/4u);
        uint a = frameWords[frameWords[2]+uint(search.sourceOrigin+y*search.sourceStride+x)/4u];
        uint b = packedReferenceLuma(ref, y*search.referenceStride+x);
        sum += absoluteBytePairs(a,b)+absoluteBytePairs(a>>8u,b>>8u);
    }
    return int((sum&65535u)+(sum>>16u));
}
#endif
#endif
int satdCandidateBlock(Search search, Reference ref, int component, ivec4 weights, int x, int y) {
    ivec4 rows[4];
#ifdef FRAME_MOTION_PARALLEL
    for (int r = 0; r < 4; ++r) {
        int src = search.sourceOrigin + (y+r)*search.sourceStride+x;
        uint a = frameWords[frameWords[2]+uint(src)/4u];
        uint b = packedReferenceLuma(ref, (y+r)*search.referenceStride+x);
        rows[r] = unpackLuma(a)-unpackLuma(b);
    }
#else
    for (int r = 0; r < 4; ++r)
        rows[r] = ivec4(residual(search, ref, component, weights, x, y+r),
                        residual(search, ref, component, weights, x+1, y+r),
                        residual(search, ref, component, weights, x+2, y+r),
                        residual(search, ref, component, weights, x+3, y+r));
#endif
    return satd4x4(rows);
}
int distortion(Search search, ivec2 mv, bool satd, int component) {
#ifdef FRAME_MOTION
    Reference ref = quarterReference(mv, search.referenceStride, search.referenceOrigin);
#else
    Reference ref = quarterReference(mv, stride, origin);
#endif
    ivec2 size = search.size;
    ivec4 weights = ivec4(0);
    if (component >= 0 && search.chromaMode != 3) {
        int verticalShift = search.chromaMode == 1 ? 1 : 0;
        size >>= ivec2(1, verticalShift);
        int y = ((mv.y + search.chromaOffsetY)*2) >> verticalShift;
        int fx = mv.x & 7, fy = y & 7;
        weights = ivec4(8-fx, fx, 8-fx, fx) * ivec4(8-fy, 8-fy, fy, fy);
        ref.start0 = origin + (y >> 3)*stride + 2*(mv.x >> 3);
    }
    int sum = 0;
#ifdef FRAME_MOTION_PARALLEL
    if (!satd) return subgroupAdd(partialLumaSad(search, ref, gl_SubgroupInvocationID, gl_SubgroupSize));
    for (uint block = gl_SubgroupInvocationID; block < 16u; block += gl_SubgroupSize) {
        int x = 4*(int(block)&3), y = 4*(int(block)/4);
        sum += satdCandidateBlock(search, ref, component, weights, x, y);
    }
    return subgroupAdd(sum);
#else
    if (satd) {
        for (int y = 0; y < size.y; y += 4)
            for (int x = 0; x < size.x; x += 4)
                sum += satdCandidateBlock(search, ref, component, weights, x, y);
    } else {
        for (int y = 0; y < size.y; ++y)
            for (int x = 0; x < size.x; ++x)
                sum += abs(residual(search, ref, component, weights, x, y));
    }
    return sum;
#endif
}
int motionBits(Search search, ivec2 mv) {
    ivec2 d = mv - search.mvp + costRadius;
#ifdef FRAME_MOTION
    return int(frameWords[frameHeader+d.x] + frameWords[frameHeader+d.y]);
#else
    return int(fixtures[search.fixture].motionCost[d.x] + fixtures[search.fixture].motionCost[d.y]);
#endif
}
int cost(Search search, ivec2 mv, bool satd) {
    return distortion(search, mv, satd, -1) + motionBits(search, mv);
}
int refinedCost(Search search, ivec2 mv, bool satd, int threshold) {
    int score = cost(search, mv, satd);
    if (search.chromaMode != 0 && (search.chromaMode == 3 || min(search.size.x, search.size.y) >= 8)) {
        if (score < threshold) score += distortion(search, mv, satd, 0);
        if (score < threshold) score += distortion(search, mv, satd, 1);
    }
    return score;
}
bool consider(Search search, inout Choice best, ivec2 mv, bool satd) {
    int score = cost(search, mv, satd);
    if (score >= best.cost) return false;
    best = Choice(mv, score);
    return true;
}
bool considerFull(Search search, inout Choice best, ivec2 fullpel) {
    int score = cost(search, fullpel*4, search.fpelSatd);
    if (score >= best.cost) return false;
    best = Choice(fullpel, score);
    return true;
}
bool nonzero(ivec2 v) { return any(notEqual(v, ivec2(0))); }
uint rangePack(ivec2 v) { return (uint(v.x) << 16) | (uint(v.y) & 0x7fffu); }
bool inRange(Search search, ivec2 mv) {
    uint v = rangePack(mv);
    uint lo = rangePack(-search.minFpel);
    uint hi = rangePack(search.maxFpel) | 0x8000u;
    return (((v + lo) | (hi - v)) & 0x80004000u) == 0u;
}
#ifdef FRAME_MOTION_BATCH
int candidateIndex() { return int(gl_SubgroupInvocationID >> 3u); }

// Each of the four groups of eight lanes computes one candidate. Placing
// the candidate index below the score preserves the original tie order.
int batchWinner(Search search, ivec2 mv, bool satd, bool enabled) {
    uint lane = gl_SubgroupInvocationID & 7u;
    int score = 0;
    if (enabled) {
        Reference ref = quarterReference(mv, search.referenceStride, search.referenceOrigin);
        if (satd) {
            int x = 4*int(lane&3u), y = 4*int(lane>>2u);
            score = satdCandidateBlock(search, ref, -1, ivec4(0), x, y);
            score += satdCandidateBlock(search, ref, -1, ivec4(0), x, y+8);
        } else {
            score = partialLumaSad(search, ref, lane, 8u);
        }
    }
    score += subgroupShuffleXor(score, 1u);
    score += subgroupShuffleXor(score, 2u);
    score += subgroupShuffleXor(score, 4u);
    return subgroupMin(4*(enabled ? score+motionBits(search, mv) : costMax) + candidateIndex());
}

int squareBatch(Search search, inout Choice best, ivec2 center, int radius, int first,
                int mvScale, bool satd, bool enabled) {
    int winner = batchWinner(search, (center+radius*square[first+candidateIndex()])*mvScale, satd, enabled);
    if ((winner >> 2) >= best.cost) return -1;
    int direction = winner & 3;
    best = Choice(center+radius*square[first+direction], winner >> 2);
    return direction;
}
#endif
void fullDiamond(Search search, inout Choice best, ivec2 center) {
#ifdef FRAME_MOTION_BATCH
    squareBatch(search, best, center, 1, 0, 4, false, true);
#else
    for (int i = 0; i < 4; ++i) considerFull(search, best, center + square[i]);
#endif
}
void hexSearch(Search search, inout Choice best, int range) {
    int direction = -1;
    ivec2 center = best.mv;
    for (int i = 0; i < 6; ++i)
        if (considerFull(search, best, center + hexagon[i+1])) direction = i;
    if (direction >= 0) {
        for (int i = (range >> 1)-1; i > 0 && inRange(search, best.mv); --i) {
            int step = -2;
            center = best.mv;
            for (int j = 0; j < 3; ++j)
                if (considerFull(search, best, center + hexagon[direction+j])) step = j-1;
            if (step == -2) break;
            direction = (direction+step+6)%6;
        }
    }
    center = best.mv;
#ifdef FRAME_MOTION_BATCH
    squareBatch(search, best, center, 1, 0, 4, false, true);
    squareBatch(search, best, center, 1, 4, 4, false, true);
#else
    for (int i = 0; i < 8; ++i) considerFull(search, best, center + square[i]);
#endif
}
void crossSearch(Search search, inout Choice best, ivec2 center, int start, int maxX, int maxY) {
    for (int i = start; i < maxX; i += 2) {
        if (center.x+i <= search.maxFpel.x) considerFull(search, best, center + ivec2(i,0));
        if (center.x-i >= search.minFpel.x) considerFull(search, best, center - ivec2(i,0));
    }
    for (int i = start; i < maxY; i += 2) {
        if (center.y+i <= search.maxFpel.y) considerFull(search, best, center + ivec2(0,i));
        if (center.y-i >= search.minFpel.y) considerFull(search, best, center - ivec2(0,i));
    }
}
int manhattan(ivec2 offset) {
    return abs(offset.x)+abs(offset.y);
}
void umhSearch(Search search, inout Choice best, ivec2 predictor, int pixelSize, int range) {
    int initialCost = best.cost;
    fullDiamond(search, best, predictor);
    if (nonzero(predictor)) fullDiamond(search, best, ivec2(0));
    if (pixelSize == 6) {
        hexSearch(search, best, range);
        return;
    }
    int predictorCost = best.cost;
    if (nonzero(best.mv) && any(notEqual(best.mv, predictor))) fullDiamond(search, best, best.mv);
    int crossStart = best.cost == predictorCost ? 3 : 1;
    ivec2 center = best.mv;
    int shift = sizeShift[pixelSize];
    if (best.cost == predictorCost && best.cost < (2000 >> shift)) {
        for (int i = 0; i < 8; ++i) considerFull(search, best, center + diamond2[i]);
        if (best.cost == initialCost && best.cost < (500 >> shift)) return;
        if (best.cost == predictorCost) {
            int smallRange = (range >> 1) | 1;
            crossSearch(search, best, center, 3, smallRange, smallRange);
            for (int i = 0; i < 8; ++i) considerFull(search, best, center + octagon[i]);
            if (best.cost == predictorCost) return;
            crossStart = smallRange+2;
        }
    }
#ifndef FRAME_MOTION
    int count = fixtures[search.fixture].predictorCount;
    if (count != 0) {
        int spread = 0, denom = 1;
        if (count == 1 && pixelSize == 0) spread = 25;
        else if (count == 1) spread = manhattan(search.mvp - fixtures[search.fixture].predictors[0]);
        else {
            denom = count-1;
            if (pixelSize != 0) {
                spread = manhattan(search.mvp - fixtures[search.fixture].predictors[0]);
                ++denom;
            }
            for (int i = 1; i < count; ++i)
                spread += manhattan(fixtures[search.fixture].predictors[i] - fixtures[search.fixture].predictors[i-1]);
        }
        int sadContext = best.cost < (1000 >> shift) ? 0 : best.cost < (2000 >> shift) ? 1 :
                         best.cost < (4000 >> shift) ? 2 : 3;
        int mvContext = spread < 10*denom ? 0 : spread < 20*denom ? 1 : spread < 40*denom ? 2 : 3;
        range = (range * rangeMultiplier[mvContext][sadContext]) >> 2;
    }
#endif
    crossSearch(search, best, center, crossStart, range, range >> 1);
    for (int x = -2; x <= 2; x += 4)
        for (int y = -2; y <= 2; y += 4) considerFull(search, best, center + ivec2(x,y));

    center = best.mv;
    ivec2 margin = min(search.maxFpel-center, center-search.minFpel);
    int ring = 1;
    do {
        bool check = 4*ring > min(margin.x, margin.y);
#ifdef FRAME_MOTION_BATCH
        for (int first = 0; first < 16; first += 4) {
            ivec2 point = center + ring*hexGrid[first+candidateIndex()];
            int winner = batchWinner(search, point*4, false, !check || inRange(search, point));
            if ((winner >> 2) < best.cost)
                best = Choice(center+ring*hexGrid[first+(winner&3)], winner >> 2);
        }
#else
        for (int i = 0; i < 16; ++i) {
            ivec2 point = center + ring*hexGrid[i];
            if (!check || inRange(search, point)) considerFull(search, best, point);
        }
#endif
    } while (++ring <= (range >> 2));
    if (all(greaterThanEqual(best.mv, search.minFpel)) && all(lessThanEqual(best.mv, search.maxFpel)))
        hexSearch(search, best, range);
}

#ifndef FRAME_MOTION
int encodedDc(Search search, ivec2 start, int side) {
    int sum = 0;
    for (int y = 0; y < side; ++y)
        for (int x = 0; x < side; ++x)
            sum += int(fixtures[search.fixture].source[(start.y+y)*16+start.x+x]);
    return sum;
}
int referenceDc(Search search, ivec2 start, int side) {
    int sum = 0;
    for (int y = 0; y < side; ++y)
        for (int x = 0; x < side; ++x)
            sum += int(fixtures[search.fixture].reference[0][origin + (start.y+y)*stride + start.x+x]);
    return sum;
}
int adsCost(Search search, ivec2 point, int side, ivec2 blocks, ivec4 dc) {
    int difference = abs(dc.x - referenceDc(search, point, side));
    if (blocks.x == 2) difference += abs(dc.y - referenceDc(search, point + ivec2(side,0), side));
    if (blocks.y == 2) difference += abs(dc.z - referenceDc(search, point + ivec2(0,side), side));
    if (blocks == ivec2(2)) difference += abs(dc.w - referenceDc(search, point + side, side));
    int delta = 4*point.x - search.mvp.x;
    return difference + int(fixtures[search.fixture].motionCost[costRadius+delta]);
}
void exhaustiveSearch(Search search, inout Choice best, int pixelSize, int range, bool tesa) {
    ivec2 lower = max(best.mv-range, search.minFpel), upper = min(best.mv+range, search.maxFpel);
    int width = (upper.x-lower.x+3) & ~3;
    int blockSide = pixelSize <= 3 ? 8 : 4;
    ivec2 blocks = search.size / blockSide;
    ivec4 dc = ivec4(encodedDc(search, ivec2(0), blockSide),
                     encodedDc(search, ivec2(blockSide,0), blockSide),
                     encodedDc(search, ivec2(0,blockSide), blockSide),
                     encodedDc(search, ivec2(blockSide), blockSide));
    int sadFactor = range <= 16 ? 10 : range <= 24 ? 11 : 12;
    int bestSad = tesa ? cost(search, best.mv*4, false) : 0;
    int count = 0;
    uint f = search.fixture;
    for (int y = lower.y; y <= upper.y; ++y) {
        int yCost = int(fixtures[f].motionCost[costRadius+4*y-search.mvp.y]);
        int rowBest = tesa ? bestSad : best.cost;
        if (rowBest <= yCost) continue;
        int adsLimit = tesa ? ((rowBest-yCost)*17) >> 4 : rowBest-yCost;
        for (int i = 0; i < width; ++i) {
            ivec2 point = ivec2(lower.x+i, y);
            if (adsCost(search, point, blockSide, blocks, dc) >= adsLimit) continue;
            if (tesa) {
                // x264 indexes the SAD shortlist's x-cost by its row-relative
                // candidate index. ADS and the final comparison use the actual MV.
                int sad = distortion(search, point*4, false, -1) + yCost
                        + int(fixtures[f].motionCost[costRadius+4*i-search.mvp.x]);
                if (sad-yCost < (((bestSad-yCost)*sadFactor) >> 3)) {
                    bestSad = min(bestSad, sad);
                    fixtures[f].tesaCandidates[count++] = ivec2(sad, (point.x & 65535) | (point.y << 16));
                }
            } else {
                considerFull(search, best, point);
            }
        }
    }
    if (!tesa) return;
    int limit = range >> 1;
    int threshold = (bestSad*sadFactor) >> 3;
    while (count > limit*2 && threshold > bestSad) {
        threshold = (threshold+bestSad) >> 1;
        int kept = 0;
        while (kept < count && fixtures[f].tesaCandidates[kept].x <= threshold) ++kept;
        for (int i = kept; i < count; ++i) {
            ivec2 candidate = fixtures[f].tesaCandidates[i];
            fixtures[f].tesaCandidates[kept] = candidate;
            if (candidate.x <= threshold) ++kept;
        }
        count = kept;
    }
    while (count > limit) {
        int worst = 0;
        for (int i = 1; i < count; ++i)
            if (fixtures[f].tesaCandidates[i].x > fixtures[f].tesaCandidates[worst].x) worst = i;
        --count;
        fixtures[f].tesaCandidates[worst] = fixtures[f].tesaCandidates[count];
    }
    for (int i = 0; i < count; ++i) {
        int packed = fixtures[f].tesaCandidates[i].y;
        considerFull(search, best, ivec2(bitfieldExtract(packed, 0, 16), packed >> 16));
    }
}

#endif
void refine(Search search, inout Choice best, int subme, ivec2 iterations, bool finalRefine,
            inout int threshold, inout int mvCost) {
#ifdef FRAME_MOTION
    const ivec2 minQpel = ivec2(-32), maxQpel = ivec2(32);
    const bool satd = true, useThreshold = false;
#else
    uint fixture = search.fixture;
    ivec2 minQpel = fixtures[fixture].minQpel, maxQpel = fixtures[fixture].maxQpel;
    bool satd = fixtures[fixture].useSatd != 0, useThreshold = fixtures[fixture].useThreshold != 0;
#endif
    if (iterations.x != 0 && subme < 3) {
        ivec2 mvp = clamp(search.mvp, minQpel+2, maxQpel-2);
        if (any(notEqual(mvp, best.mv))) consider(search, best, mvp, search.fpelSatd);
    }
    for (int i = 0; i < iterations.x; ++i) {
        ivec2 center = best.mv;
#ifdef FRAME_MOTION_BATCH
        squareBatch(search, best, center, 2, 0, 1, false, true);
#else
        for (int j = 0; j < 4; ++j) consider(search, best, center + 2*square[j], search.fpelSatd);
#endif
        if (all(equal(best.mv, center))) break;
    }
    bool chromaMe = search.chromaMode != 0 && (search.chromaMode == 3 || min(search.size.x, search.size.y) >= 8);
    if (!finalRefine && (satd != search.fpelSatd || chromaMe)) best.cost = refinedCost(search, best.mv, satd, costMax);
    if (!finalRefine && useThreshold) {
        if (((best.cost*7) >> 3) > threshold) return;
        threshold = min(threshold, best.cost);
    }
    if (subme == 1) {
        ivec2 center = best.mv;
        if (all(greaterThan(center, minQpel)) && all(lessThan(center, maxQpel)))
            for (int j = 0; j < 4; ++j) consider(search, best, center + square[j], search.fpelSatd);
        mvCost = motionBits(search, best.mv);
        return;
    }
    int direction = -1;
    for (int i = 0; i < iterations.y; ++i) {
        ivec2 center = best.mv;
        if (any(lessThanEqual(center, minQpel)) || any(greaterThanEqual(center, maxQpel))) break;
        int previous = direction;
#ifdef FRAME_MOTION_BATCH
        bool enabled = finalRefine || (candidateIndex()^1) != previous;
        int winner = squareBatch(search, best, center, 1, 0, 1, true, enabled);
        if (winner >= 0) direction = winner;
#else
        for (int j = 0; j < 4; ++j) {
            if (!finalRefine && (j^1) == previous) continue;
            ivec2 mv = center + square[j];
            int score = refinedCost(search, mv, satd, best.cost);
            if (score < best.cost) {
                best = Choice(mv, score);
                direction = j;
            }
        }
#endif
        if (all(equal(best.mv, center))) break;
    }
    mvCost = motionBits(search, best.mv);
}

Choice searchMotion(Search search, int subme, int pixelSize, int range, int method, inout int threshold, inout int mvCost);

#ifndef FRAME_MOTION
void storeChoice(uint f, Choice best, int mvCost, int threshold) {
    fixtures[f].resultX = best.mv.x;
    fixtures[f].resultY = best.mv.y;
    fixtures[f].resultCost = best.cost;
    fixtures[f].resultMvCost = mvCost;
    fixtures[f].threshold = threshold;
}

void main() {
    uint f = gl_GlobalInvocationID.x;
    if (f >= fixtures.length()) return;
    int pixelSize = fixtures[f].pixelSize, subme = fixtures[f].subme, range = fixtures[f].range;
    int method = fixtures[f].method;
    int chromaMode = fixtures[f].chromaMode;
    int chromaOffsetY = chromaMode == 1 && (fixtures[f].interlaced & fixtures[f].refIndex & 1) != 0 ?
                        (fixtures[f].fieldY & 1)*4-2 : 0;
    Search search = Search(f, sizes[pixelSize], fixtures[f].mvp, fixtures[f].minFpel, fixtures[f].maxFpel,
                           fixtures[f].weighted != 0, method == tesaMethod && fixtures[f].useSatd != 0,
                           fixtures[f].scale, fixtures[f].denom, fixtures[f].offset,
                           chromaMode, chromaOffsetY);
    int threshold = fixtures[f].threshold;
    int mvCost = fixtures[f].resultMvCost;
    int operation = fixtures[f].operation;
    if (operation != 0) {
        Choice best = Choice(ivec2(fixtures[f].resultX, fixtures[f].resultY), fixtures[f].resultCost);
        bool finalRefine = operation == 1;
        if (finalRefine && pixelSize <= 3) best.cost -= fixtures[f].refCost;
        ivec2 iterations = finalRefine ? finalIterations[subme] : ivec2(0, min(2, searchIterations[subme].y));
        refine(search, best, subme, iterations, finalRefine, threshold, mvCost);
        storeChoice(f, best, mvCost, threshold);
        return;
    }
    Choice best = searchMotion(search, subme, pixelSize, range, method, threshold, mvCost);
    storeChoice(f, best, mvCost, threshold);
}
#endif

Choice searchMotion(Search search, int subme, int pixelSize, int range, int method, inout int threshold, inout int mvCost) {
    uint f = search.fixture;
    bool subpelPredictors = subme >= 3;
    ivec2 limitMin = subpelPredictors ? search.minFpel*4 : search.minFpel;
    ivec2 limitMax = subpelPredictors ? search.maxFpel*4 : search.maxFpel;
    ivec2 mvp = clamp(subpelPredictors ? search.mvp : (search.mvp+2) >> 2, limitMin, limitMax);
    int initialCost = subpelPredictors ? cost(search, mvp, search.fpelSatd) :
                                        distortion(search, mvp*4, search.fpelSatd, -1);
    Choice predicted = Choice(mvp, initialCost);
#ifndef FRAME_MOTION
    for (int i = 0; i < fixtures[f].predictorCount; ++i) {
        ivec2 mv = fixtures[f].predictors[i];
        if (!subpelPredictors) mv = (mv+2) >> 2;
        if (!nonzero(mv) || all(equal(mvp, mv))) continue;
        mv = clamp(mv, limitMin, limitMax);
        if (subpelPredictors) consider(search, predicted, mv, search.fpelSatd);
        else considerFull(search, predicted, mv);
    }
#endif
    Choice best = predicted;
    if (subpelPredictors) {
        best.mv = (predicted.mv+2) >> 2;
        if (nonzero(predicted.mv & 3)) best.cost = cost(search, best.mv*4, search.fpelSatd);
        if (nonzero(mvp)) {
            if (nonzero(best.mv)) considerFull(search, best, ivec2(0));
        } else if (initialCost < best.cost) {
            best = Choice(ivec2(0), initialCost);
        }
    } else if (nonzero(mvp)) {
        considerFull(search, best, ivec2(0));
    }
    if (method == diaMethod) {
        int i = range;
        do {
            ivec2 center = best.mv;
            fullDiamond(search, best, center);
            if (all(equal(center, best.mv))) break;
        } while (--i != 0 && inRange(search, best.mv));
    } else if (method == hexMethod) {
        hexSearch(search, best, range);
    } else if (method == umhMethod) {
        umhSearch(search, best, subpelPredictors ? (mvp+2) >> 2 : mvp, pixelSize, range);
#ifndef FRAME_MOTION
    } else if (method == esaMethod || method == tesaMethod) {
        exhaustiveSearch(search, best, pixelSize, range, method == tesaMethod);
#endif
    }
    if (!subpelPredictors) {
        bool isMvp = all(equal(best.mv, mvp));
        best.mv *= 4;
        mvCost = motionBits(search, best.mv);
        if (isMvp) best.cost += mvCost;
    } else {
        best.mv *= 4;
        if (predicted.cost < best.cost) best = predicted;
    }
    if (subme >= 2) refine(search, best, subme, searchIterations[subme], false, threshold, mvCost);
    return best;
}

#ifdef FRAME_MOTION
int frameChroma(uint base, ivec2 p, ivec4 weights) {
    ivec2 size = ivec2(frameWidth(), frameHeight()) / 2;
    ivec2 lo = clamp(p, ivec2(0), size-1), hi = clamp(p+1, ivec2(0), size-1);
    int top = lo.y*size.x, bottom = hi.y*size.x;
    return (weights.x*sampleByte(base, top+lo.x) + weights.y*sampleByte(base, top+hi.x) +
            weights.z*sampleByte(base, bottom+lo.x) + weights.w*sampleByte(base, bottom+hi.x) + 32) >> 6;
}

#ifdef FRAME_MOTION_TILE
shared ivec2 tileVectors[8];

ivec2 tileVector(int mb, int x, int y, ivec2 tileOrigin, int tileWidth) {
    ivec2 tile = ivec2(x+y,y)-tileOrigin;
    if (mb >= 0 && all(greaterThanEqual(tile, ivec2(0))) && tile.x < tileWidth && tile.y < 2)
        return tileVectors[tile.y*tileWidth+tile.x];
    return vectorAt(mb);
}
#endif

ivec2 encodeMotion(int x, int y, int width, uint mbLane, uint mbLanes
#ifdef FRAME_MOTION_TILE
                    , ivec2 tileOrigin, int tileWidth, bool hasLeft, ivec2 left
#endif
                  ) {
    int mb = y*width+x;
    ivec4 indices = ivec4(x > 0 ? mb-1 : -1, y > 0 ? mb-width : -1,
                         y > 0 && x+1 < width ? mb-width+1 : -1, y > 0 && x > 0 ? mb-width-1 : -1);
    ivec4 refs = 2*ivec4(lessThan(indices, ivec4(0))) * -1;
#ifdef FRAME_MOTION_TILE
    ivec2 mvp = predictMotion16(0, refs, hasLeft ? left : tileVector(indices.x, x-1, y, tileOrigin, tileWidth),
        tileVector(indices.y, x, y-1, tileOrigin, tileWidth),
        tileVector(indices.z, x+1, y-1, tileOrigin, tileWidth),
        tileVector(indices.w, x-1, y-1, tileOrigin, tileWidth));
#else
    ivec2 mvp = predictMotion16(0, refs, vectorAt(indices.x), vectorAt(indices.y),
                               vectorAt(indices.z), vectorAt(indices.w));
#endif
    int refStride = referenceStride();
    int refOrigin = (16*y+border)*refStride + 16*x+border;
    Search search = Search(uint(mb), ivec2(16), mvp, ivec2(-8), ivec2(8), false, false, 0, 0, 0, 0, 0,
                           16*y*frameWidth()+16*x, refOrigin, frameWidth(), refStride);
    int threshold = 0, mvCost = 0;
    ivec2 mv = searchMotion(search, 8, 0, 8, umhMethod, threshold, mvCost).mv;
    uint dest = resultIndex(uint(mb));
    if (mbLane == 0u) {
#ifdef FRAME_MOTION_TILE
        ivec2 tile = ivec2(x+y,y)-tileOrigin;
        if (tileWidth != 0) tileVectors[tile.y*tileWidth+tile.x] = mv;
#endif
        frameWords[dest] = uint(mv.x);
        frameWords[dest+1] = uint(mv.y);
    }
    Reference ref = quarterReference(mv, refStride, refOrigin);
    for (uint index = mbLane; index < 64u; index += mbLanes) {
        int row = int(index)/4, col = 4*(int(index)%4);
        int offset = row*refStride+col;
#ifdef FRAME_MOTION_PARALLEL
        uint word = packedReferenceLuma(ref, offset);
#else
        uint word = 0;
        for (int i = 0; i < 4; ++i) word |= uint(frameLuma(ref, offset+i)) << (8*i);
#endif
        frameWords[dest+2+index] = word;
    }
    ivec2 fraction = mv & 7;
    ivec4 weights = ivec4(8-fraction.x, fraction.x, 8-fraction.x, fraction.x) *
                    ivec4(8-fraction.y, 8-fraction.y, fraction.y, fraction.y);
    ivec2 originChroma = ivec2(x,y)*8 + (mv >> 3);
    for (uint index = mbLane; index < 32u; index += mbLanes) {
        uint base = frameWords[5+index/16];
        int row = (int(index)%16)/2, col = 4*(int(index)%2);
        uint word = 0;
        for (int i = 0; i < 4; ++i)
            word |= uint(frameChroma(base, originChroma+ivec2(col+i,row), weights)) << (8*i);
        frameWords[dest+66+index] = word;
    }
    return mv;
}

void main() {
    int width = frameWidth()/16, height = frameHeight()/16;
#ifdef FRAME_MOTION_TILE
    // In coordinates (x+y, y), all motion predictors are left, above, or
    // above-left. The host orders tiles, and shared memory orders each tile.
    int tileWidth = int((wave.index >> 16u)&255u);
    int diagonal = int(wave.index & 65535u);
    if ((wave.index >> 24u) == 1u) {
        int y = int(gl_WorkGroupID.x*gl_NumSubgroups+gl_SubgroupID), column = diagonal-y;
        if (y >= height || column < 0) return;
        int first = column*tileWidth-y;
        ivec2 left = ivec2(0);
        for (int x = max(0,first); x < min(width,first+tileWidth); ++x)
            left = encodeMotion(x, y, width, gl_SubgroupInvocationID, gl_SubgroupSize,
                                ivec2(0), 0, x > max(0,first), left);
        return;
    }
    int tileRow = int(gl_WorkGroupID.x), tileColumn = diagonal-tileRow;
    if (tileColumn < 0 || tileColumn*tileWidth >= width+height-1) return;
    ivec2 tileOrigin = ivec2(tileColumn*tileWidth,tileRow*2);
    int localRow = int(gl_SubgroupID), y = tileOrigin.y+localRow;
    for (int step = 0; step <= tileWidth; ++step) {
        int localColumn = step-localRow, x = tileOrigin.x+localColumn-y;
        if (localColumn >= 0 && localColumn < tileWidth && x >= 0 && x < width && y < height)
            encodeMotion(x, y, width, gl_SubgroupInvocationID, gl_SubgroupSize, tileOrigin, tileWidth, false, ivec2(0));
        barrier();
    }
#else
#ifdef FRAME_MOTION_PARALLEL
    // Each subgroup follows one search path. Its lanes share exact integer costs.
    uint mbLane = gl_SubgroupInvocationID, mbLanes = gl_SubgroupSize;
    int y = int(gl_WorkGroupID.x*gl_NumSubgroups + gl_SubgroupID);
#else
    const uint mbLane = 0u, mbLanes = 1u;
    int y = int(gl_GlobalInvocationID.x);
#endif
    int x = int(wave.index)-2*y;
    if (x >= 0 && x < width && y < height) encodeMotion(x, y, width, mbLane, mbLanes);
#endif
}
#endif
