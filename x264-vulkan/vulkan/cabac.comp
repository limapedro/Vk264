        frameTransition[i][1] = transition[i][1];
    }
    frameRenormShift[lane] = renormShift[lane];
    const int stride = 64;
#else
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    const int lane = 0, stride = 1;
#endif
    int model = fixtures[fixture].model;
    int qp = fixtures[fixture].qp;
    int contexts = fixtures[fixture].chroma444 != 0 ? 1024 : 460;
    for (int i = lane; i < contexts; i += stride) {
#ifdef CABAC_SHARED_FRAME
        frameContext[i] = initialContext(model, qp, i);
#else
        fixtures[fixture].context[i] = initialContext(model, qp, i);
#endif
    }
#ifdef CABAC_SHARED_FRAME
    barrier();
    if (lane == 0) encodeOperations(fixture);
#else
    encodeOperations(fixture);
#endif
}
