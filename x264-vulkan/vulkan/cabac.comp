#version 450
#extension GL_GOOGLE_include_directive : require
#include "macroblock4_order.glsl"
#include "mv_predict_math.glsl"
layout(local_size_x = 64) in;

#ifndef CABAC_MAX_OPERATIONS
#define CABAC_MAX_OPERATIONS 160
#endif
#ifndef CABAC_RESIDUAL_WORDS
#define CABAC_RESIDUAL_WORDS 8192
#endif
const int maxOperations = CABAC_MAX_OPERATIONS;
#ifndef CABAC_MAX_BYTES
#define CABAC_MAX_BYTES 768
#endif
const int maxBytes = CABAC_MAX_BYTES;
const int decision = 0, bypass = 1, ueBypass = 2, terminal = 3, residual = 4;
const int intraType = 5, intra4x4Mode = 6, intraChromaMode = 7;
const int intra16Macroblock = 8;
const int codedBlockPattern = 9, qpDelta = 10, transformSize = 11;
const int macroblockSkip = 12, mvdComponent = 13, inter16Macroblock = 14;
const int chromaOffset = 4+16+16*15;
const int chromaPlaneWords = 2+4+4*15;
const int macroblockWords = chromaOffset+2+2*chromaPlaneWords;
struct Operation {
    int kind, first, second;
};
struct Fixture {
    int qp, model, chroma444, frame, count, finish;
    Operation operations[maxOperations];
    int coefficients[64];
    uint context[1024];
    uint bytes[maxBytes];
    int low, range, queue, outstanding, position, effectiveQp, mvdMagnitude;
};
layout(std430, binding = 0) buffer Corpus {
    int contextInit[4][1024][2];
    int rangeLps[64][4];
    int transition[128][2];
    int renormShift[64];
    int significantBase[2][16], lastBase[2][16], levelBase[16], countMinusOne[14];
    int significant8x8[2][64], last8x8[63], significance422[7];
    int residualBank[CABAC_RESIDUAL_WORDS];
    Fixture fixtures[];
