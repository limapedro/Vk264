#version 450
layout(local_size_x = 64) in;

const int stride = 32;
const int origin = stride + 8;
const int mbLeft = 1, mbTop = 2, mbTopRight = 4, mbTopLeft = 8;
struct Fixture {
    int side, mode, neighbors, filters;
    uint pixels[17 * stride];
    uint edge[36];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

int top(uint fixture, int x) { return int(fixtures[fixture].pixels[origin - stride + x]); }
int left(uint fixture, int y) { return int(fixtures[fixture].pixels[origin - 1 + stride*y]); }
int avg2(int a, int b) { return (a + b + 1) >> 1; }
int avg3(int a, int b, int c) { return (a + 2*b + c + 2) >> 2; }

void filter8x8(uint fixture) {
    int neighbors = fixtures[fixture].neighbors;
    int filters = fixtures[fixture].filters;
    bool haveTopLeft = (neighbors & mbTopLeft) != 0;
    if ((filters & mbLeft) != 0) {
        fixtures[fixture].edge[15] = uint(avg3(top(fixture, 0), top(fixture, -1), left(fixture, 0)));
        fixtures[fixture].edge[14] = uint(avg3(haveTopLeft ? top(fixture, -1) : left(fixture, 0),
                                             left(fixture, 0), left(fixture, 1)));
        for (int y = 1; y <= 6; ++y)
            fixtures[fixture].edge[14-y] = uint(avg3(left(fixture, y-1), left(fixture, y), left(fixture, y+1)));
        uint tail = uint(avg3(left(fixture, 6), left(fixture, 7), left(fixture, 7)));
        fixtures[fixture].edge[6] = tail;
        fixtures[fixture].edge[7] = tail;
    }
    if ((filters & mbTop) != 0) {
        bool haveTopRight = (neighbors & mbTopRight) != 0;
        fixtures[fixture].edge[16] = uint(avg3(haveTopLeft ? top(fixture, -1) : top(fixture, 0),
                                             top(fixture, 0), top(fixture, 1)));
        for (int x = 1; x <= 6; ++x)
            fixtures[fixture].edge[16+x] = uint(avg3(top(fixture, x-1), top(fixture, x), top(fixture, x+1)));
        fixtures[fixture].edge[23] = uint(avg3(top(fixture, 6), top(fixture, 7),
                                             top(fixture, haveTopRight ? 8 : 7)));
        if ((filters & mbTopRight) != 0) {
            for (int x = 8; x <= 15; ++x) {
                int value = haveTopRight ? avg3(top(fixture, x-1), top(fixture, x),
                                               top(fixture, min(x+1, 15))) : top(fixture, 7);
                fixtures[fixture].edge[16+x] = uint(value);
            }
            fixtures[fixture].edge[32] = fixtures[fixture].edge[31];
        }
    }
}

// Ordered along the corner. Index 8 is top-left, above pixels follow, left pixels precede.
const int corner = 8;
int verticalRight(int refs[25], int x, int y, int direction) {
    int z = 2*x - y;
    if (z < 0) {
        int p = corner + direction*z;
        return avg3(refs[p], refs[p + direction], refs[p + 2*direction]);
    }
    int p = corner + direction*(x - y/2);
    if ((y & 1) == 0) return avg2(refs[p], refs[p + direction]);
    return avg3(refs[p - direction], refs[p], refs[p + direction]);
}

int intraPixel(int refs[25], int side, int mode, int dc, int x, int y) {
    switch (mode) {
        case 0: return refs[corner + 1 + x]; // Vertical
        case 1: return refs[corner - 1 - y]; // Horizontal
        case 3: { // Diagonal down-left
            int p = corner + 1 + x + y;
            return avg3(refs[p], refs[p+1], refs[min(p+2, corner + 2*side)]);
        }
        case 4: { // Diagonal down-right
            int p = corner + x - y;
            return avg3(refs[p-1], refs[p], refs[p+1]);
        }
        case 5: return verticalRight(refs, x, y, 1); // Vertical-right
        case 6: return verticalRight(refs, y, x, -1); // Horizontal-down
        case 7: { // Vertical-left
            int p = corner + 1 + x + y/2;
            if ((y & 1) == 0) return avg2(refs[p], refs[p+1]);
            return avg3(refs[p], refs[p+1], refs[p+2]);
        }
        case 8: { // Horizontal-up
            int p = y + x/2;
            int a = refs[corner - 1 - min(p, side-1)];
            int b = refs[corner - 1 - min(p+1, side-1)];
            if ((x & 1) == 0) return avg2(a, b);
            return avg3(a, b, refs[corner - 1 - min(p+2, side-1)]);
        }
        default: return dc;
    }
}

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int side = fixtures[fixture].side;
    int mode = fixtures[fixture].mode;
    if (mode == -1) {
        filter8x8(fixture);
        return;
    }

    int refs[25];
    refs[corner] = side == 4 ? top(fixture, -1) : int(fixtures[fixture].edge[15]);
    for (int i = 0; i < 2*side; ++i)
        refs[corner + 1 + i] = side == 4 ? top(fixture, i) : int(fixtures[fixture].edge[16+i]);
    for (int i = 0; i < side; ++i)
        refs[corner - 1 - i] = side == 4 ? left(fixture, i) : int(fixtures[fixture].edge[14-i]);
    int dc = 128;
    if (mode == 2 || mode == 9 || mode == 10) {
        int sum = 0;
        for (int i = 0; i < side; ++i) {
            if (mode != 9) sum += refs[corner + 1 + i];
            if (mode != 10) sum += refs[corner - 1 - i];
        }
        int count = mode == 2 ? side*2 : side;
        dc = (sum + count/2) / count;
    }
    for (int y = 0; y < side; ++y)
        for (int x = 0; x < side; ++x)
            fixtures[fixture].pixels[origin + y*stride + x] = uint(intraPixel(refs, side, mode, dc, x, y));
}
