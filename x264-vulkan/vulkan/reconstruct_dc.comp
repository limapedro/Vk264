#version 450
layout(local_size_x = 64) in;

struct Fixture {
    int side;
    int coefficients[16];
    uint pixels[256];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int side = fixtures[fixture].side;
    int blocksPerRow = side / 4;
    for (int by = 0; by < blocksPerRow; ++by)
        for (int bx = 0; bx < blocksPerRow; ++bx) {
            int dc = (fixtures[fixture].coefficients[by*blocksPerRow + bx] + 32) >> 6;
            for (int y = 0; y < 4; ++y)
                for (int x = 0; x < 4; ++x) {
                    int p = (by*4+y)*16 + bx*4+x;
                    fixtures[fixture].pixels[p] = uint(clamp(int(fixtures[fixture].pixels[p]) + dc, 0, 255));
                }
        }
}
