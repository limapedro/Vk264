#version 450
#extension GL_GOOGLE_include_directive : require
#include "hadamard_magnitude.glsl"
layout(local_size_x = 64) in;

const int sourceStride = 16, candidateStride = 24, rows = 16;
struct Fixture {
    int width, height, count;
    uint source[sourceStride*rows];
    uint candidate[4][candidateStride*rows];
    int sad[4], ssd[4], satd[4], sa8d[4];
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

int difference(uint fixture, int candidate, int x, int y) {
    return int(fixtures[fixture].source[y*sourceStride+x])
         - int(fixtures[fixture].candidate[candidate][y*candidateStride+x]);
}
int transformMagnitude(uint fixture, int candidate, int x, int y, int side) {
    int block[64];
    for (int row = 0; row < side; ++row)
        for (int col = 0; col < side; ++col)
            block[row*side+col] = difference(fixture, candidate, x+col, y+row);
    return hadamardMagnitude(block, side);
}

void main() {
    uint fixture = gl_GlobalInvocationID.x / 4;
    if (fixture >= fixtures.length()) return;
    int candidate = int(gl_GlobalInvocationID.x % 4);
    if (candidate >= fixtures[fixture].count) return;

    int width = fixtures[fixture].width, height = fixtures[fixture].height;
    int sad = 0, ssd = 0, satd = 0;
    for (int y = 0; y < height; ++y)
        for (int x = 0; x < width; ++x) {
            int d = difference(fixture, candidate, x, y);
            sad += abs(d);
            ssd += d*d;
        }
    for (int y = 0; y < height; y += 4)
        for (int x = 0; x < width; x += 4)
            satd += transformMagnitude(fixture, candidate, x, y, 4) >> 1;
    fixtures[fixture].sad[candidate] = sad;
    fixtures[fixture].ssd[candidate] = ssd;
    fixtures[fixture].satd[candidate] = satd;
    if (width == height && width >= 8) {
        int magnitude = 0;
        for (int y = 0; y < height; y += 8)
            for (int x = 0; x < width; x += 8)
                magnitude += transformMagnitude(fixture, candidate, x, y, 8);
        fixtures[fixture].sa8d[candidate] = (magnitude + 2) >> 2;
    }
}
