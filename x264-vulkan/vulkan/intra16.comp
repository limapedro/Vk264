#version 450
#extension GL_GOOGLE_include_directive : require
#include "dct4x4_math.glsl"
#include "luma_dc_math.glsl"
#include "zigzag4_order.glsl"
#include "decimate4_table.glsl"
#include "quant_level.glsl"
#include "macroblock4_order.glsl"
layout(local_size_x = 64) in;

const int stride = 32, origin = stride+8;
#include "intra16_fixture.glsl"
#ifdef RESIDUAL_FRAME
layout(std430, binding = 1) buffer Corpus { Luma4Fixture fixtures[]; };
#else
layout(std430, binding = 0) buffer Corpus { Luma4Fixture fixtures[]; };
#endif
#include "predict_intra_math.glsl"

#include "macroblock4_math.glsl"

void transformDc(inout int dc[16], bool forward) {
    ivec4 tmp[4];
    for (int y = 0; y < 4; ++y) {
        ivec4 d = dcPass(ivec4(dc[4*y], dc[4*y+1], dc[4*y+2], dc[4*y+3]));
        for (int x = 0; x < 4; ++x) tmp[x][y] = shortValue(d[x]);
    }
    for (int x = 0; x < 4; ++x) {
        ivec4 d = dcPass(tmp[x]);
        for (int y = 0; y < 4; ++y) dc[4*x+y] = shortValue(forward ? (d[y]+1) >> 1 : d[y]);
    }
}
int decimateScore(uint f, int block, int first) {
    int position = 15, score = 0;
    while (position >= first && fixtures[f].ac[block][position] == 0) --position;
    while (position >= first) {
        if (uint(fixtures[f].ac[block][position--]+1) > 2u) return 9;
        int run = 0;
        while (position >= first && fixtures[f].ac[block][position] == 0) {
            --position;
            ++run;
        }
        score += decimateTable4[run];
    }
    return score;
}
int scanPosition(int coefficient, bool interlaced) {
    return interlaced ? scan4field[coefficient] : scan4frame[coefficient];
}
void main() {
    uint f = gl_GlobalInvocationID.x;
    if (f >= fixtures.length()) return;
#ifdef RESIDUAL_FRAME
    if (fixtures[f].field < 0) return;
#endif
    int channel = fixtures[f].plane;
    int qp = fixtures[f].qp;
    bool field = fixtures[f].field != 0;
    bool denoise = fixtures[f].denoise != 0;
    bool intra = fixtures[f].mode >= 0;
    if (intra) predictIntra(f, 16, 16, fixtures[f].mode);

    int cacheBase = 12+40*channel;
    int score = fixtures[f].decimate != 0 ? 0 : 9;
    int cbp = 0;
    int dc[16], restored[16][16];
    int groupScore = fixtures[f].decimate != 0 ? 0 : 6;
    int macroblockScore = 0, groupNonzero = 0;
    for (int block = 0; block < 16; ++block) {
        int raster = blockToRaster[block];
        int px = 4*(raster%4), py = 4*(raster/4);
        int pixels = origin+py*stride+px;
        int nonzeroIndex = cacheBase+raster/4*8+raster%4;
        ivec4 rows[4];
        for (int y = 0; y < 4; ++y) {
            ivec4 difference;
            for (int x = 0; x < 4; ++x)
                difference[x] = int(fixtures[f].source[(py+y)*16+px+x])-int(fixtures[f].pixels[pixels+y*stride+x]);
            ivec4 row = forwardPass(difference);
            for (int x = 0; x < 4; ++x) rows[x][y] = row[x];
        }
        int levels[16];
        bool nonzero = false;
        for (int x = 0; x < 4; ++x) {
            ivec4 column = forwardPass(rows[x]);
            for (int y = 0; y < 4; ++y) {
                int index = 4*x+y;
                int value = column[y];
                if (denoise) {
                    int magnitude = abs(value);
                    fixtures[f].residualSum[index] += uint(magnitude);
                    int filtered = max(magnitude-int(fixtures[f].noiseOffset[index]), 0);
                    value = value < 0 ? -filtered : filtered;
                }
                if (intra && index == 0) {
                    dc[raster] = value;
                    value = 0;
                }
                int level = quantLevel(value, fixtures[f].multiplier[index], fixtures[f].bias[index]);
                levels[index] = level;
                nonzero = nonzero || level != 0;
                restored[block][index] = dequantize(level, fixtures[f].dequant[index], qp/6-4);
            }
        }
        fixtures[f].nonzero[nonzeroIndex] = uint(nonzero);
        if (nonzero) {
            for (int i = 0; i < 16; ++i) fixtures[f].ac[block][i] = levels[scanPosition(i, field)];
            if (intra) {
                cbp = 15;
                if (score < 6) score += decimateScore(f, block, 1);
            } else {
                groupNonzero = 1;
                if (groupScore < 6) groupScore += decimateScore(f, block, 0);
            }
        }
        if (!intra && block%4 == 3) {
            if (groupNonzero != 0) {
                macroblockScore += groupScore;
                if (groupScore >= 4) cbp |= 1 << (block/4);
            }
            groupNonzero = 0;
            groupScore = fixtures[f].decimate != 0 ? 0 : 6;
        }
    }

    if (!intra) {
        if (macroblockScore < 6) cbp = 0;
        fixtures[f].cbp |= cbp;
        for (int block = 0; block < 16; ++block) {
            int raster = blockToRaster[block];
            if ((cbp & (1 << (block/4))) != 0)
                reconstruct(f, origin+4*(raster/4*stride+raster%4), restored[block]);
            else
                fixtures[f].nonzero[cacheBase+raster/4*8+raster%4] = 0;
        }
        return;
    }

    if (score < 6) {
        for (int y = 0; y < 4; ++y)
            for (int x = 0; x < 4; ++x) fixtures[f].nonzero[cacheBase+y*8+x] = 0u;
        cbp = 0;
    } else {
        fixtures[f].cbp |= cbp;
    }
    transformDc(dc, true);
    bool dcNonzero = false;
    for (int i = 0; i < 16; ++i) {
        dc[i] = quantLevel(dc[i], fixtures[f].multiplier[0] >> 1, fixtures[f].bias[0] << 1);
        dcNonzero = dcNonzero || dc[i] != 0;
    }
    fixtures[f].nonzero[channel*40] = uint(dcNonzero);
    if (dcNonzero) {
        for (int i = 0; i < 16; ++i) fixtures[f].dcCoefficients[i] = dc[scanPosition(i, field)];
        transformDc(dc, false);
        for (int i = 0; i < 16; ++i) dc[i] = dequantize(dc[i], fixtures[f].dequant[0], qp/6-6);
    }
    for (int block = 0; block < 16 && (cbp != 0 || dcNonzero); ++block) {
        int raster = blockToRaster[block];
        int pixelBase = origin+4*(raster/4*stride+raster%4);
        if (cbp != 0) {
            if (dcNonzero) restored[block][0] = dc[raster];
            reconstruct(f, pixelBase, restored[block]);
        } else {
            int delta = (dc[raster]+32) >> 6;
            for (int y = 0; y < 4; ++y)
                for (int x = 0; x < 4; ++x) {
                    int pos = pixelBase+y*stride+x;
                    fixtures[f].pixels[pos] = uint(clamp(int(fixtures[f].pixels[pos])+delta, 0, 255));
                }
        }
    }
}
