// Adaptive-quantization variance kernel. Translated from common/pixel.c
// (PIXEL_VAR_C) and encoder/ratecontrol.c (ac_energy_mb):
//
//   luma = var2_16x16(luma)     // sum + sqr, shift=8
//   cb   = var2_8x8(Cb 8x8)     // shift=6
//   cr   = var2_8x8(Cr 8x8)     // shift=6
//   energy = ac_energy(luma, 8) + ac_energy(cb, 6) + ac_energy(cr, 6)
//
// where ac_energy(sum, sqr, shift) = sqr - (sum * sum >> shift), computed
// in 32 bits (the x264 C reference needs a 64-bit intermediate for luma,
// but sums and squares fit in 32 bits for 8-bit pixels: max sum*sum is
// 4,261,478,400 < 2^32). Each invocation owns one 16x16 macroblock.
#version 450
layout(local_size_x = 64) in;

struct Fixture {
    uint luma[256];
    uint chromaCb[64];
    uint chromaCr[64];
    uint sumLuma, sqrLuma, sumCb, sqrCb, sumCr, sqrCr;
    uint energy;
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    uint lSum = 0, lSqr = 0;
    for (int i = 0; i < 256; ++i) {
        uint p = fixtures[fixture].luma[i];
        lSum += p;
        lSqr += p * p;
    }
    uint sumCb = 0, sqrCb = 0, sumCr = 0, sqrCr = 0;
    for (int i = 0; i < 64; ++i) {
        uint p = fixtures[fixture].chromaCb[i];
        sumCb += p; sqrCb += p * p;
        uint q = fixtures[fixture].chromaCr[i];
        sumCr += q; sqrCr += q * q;
    }
    fixtures[fixture].sumLuma = lSum;
    fixtures[fixture].sqrLuma = lSqr;
    fixtures[fixture].sumCb = sumCb;
    fixtures[fixture].sqrCb = sqrCb;
    fixtures[fixture].sumCr = sumCr;
    fixtures[fixture].sqrCr = sqrCr;
    fixtures[fixture].energy = (lSqr - ((lSum * lSum) >> 8))
                             + (sqrCb - ((sumCb * sumCb) >> 6))
                             + (sqrCr - ((sumCr * sumCr) >> 6));
}
