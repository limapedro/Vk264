#version 450
#extension GL_GOOGLE_include_directive : require
#include "quant_level.glsl"
layout(local_size_x = 64) in;

struct Fixture {
    int coefficients[64];
    uint multiplier[16], bias[16];
    int nonzeroMask;
};
layout(std430, binding = 0) buffer Corpus { Fixture fixtures[]; };

void main() {
    uint fixture = gl_GlobalInvocationID.x;
    if (fixture >= fixtures.length()) return;
    int nonzeroMask = 0;
    for (int block = 0; block < 4; ++block) {
        int nonzero = 0;
        for (int i = 0; i < 16; ++i) {
            int index = block*16 + i;
            int level = quantLevel(fixtures[fixture].coefficients[index],
                                   fixtures[fixture].multiplier[i], fixtures[fixture].bias[i]);
            fixtures[fixture].coefficients[index] = level;
            nonzero |= level;
        }
        nonzeroMask |= int(nonzero != 0) << block;
    }
    fixtures[fixture].nonzeroMask = nonzeroMask;
}
