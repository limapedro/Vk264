#version 450
#extension GL_GOOGLE_include_directive : require
#include "quant_level.glsl"
layout(local_size_x = 64) in;
const int count = SIDE * SIDE;
struct Block {
    int qp;
    int nonzero;
    int coefficients[count];
    uint multiplier[count];
    uint bias[count];
    int dequantMatrix[count];
    int levels[count];
    int dequantized[count];
};
layout(std430, binding = 0) buffer Corpus { Block blocks[]; };

int signed16(int value) { return bitfieldExtract(value, 0, 16); }

void main() {
    uint block = gl_GlobalInvocationID.x;
    if (block >= blocks.length()) return;
    int shift = blocks[block].qp / 6 - (SIDE == 4 ? 4 : 6);
    int nonzero = 0;
    for (int i = 0; i < count; ++i) {
        int level = quantLevel(blocks[block].coefficients[i],
                               blocks[block].multiplier[i], blocks[block].bias[i]);
        blocks[block].levels[i] = level;
        nonzero |= level;

        // The host supplies the matrix row for qp % 6.
        int product = level * blocks[block].dequantMatrix[i];
        int restored = shift >= 0 ? product * (1 << shift) :
                       (product + (1 << (-shift - 1))) >> -shift;
        blocks[block].dequantized[i] = signed16(restored);
    }
    blocks[block].nonzero = int(nonzero != 0);
}
