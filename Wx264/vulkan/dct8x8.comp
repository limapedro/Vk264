#version 450
#extension GL_GOOGLE_include_directive : require
#define BLOCK_SIDE 8
#include "dct_layout.glsl"

layout(local_size_x = 64) in;

#include "dct8x8_math.glsl"

void main() {
    uint block = gl_GlobalInvocationID.x / BLOCKS_PER_GROUP;
    if (block >= blocks.length()) return;
    int blockIndex = int(gl_GlobalInvocationID.x % BLOCKS_PER_GROUP);
    int pixelBase = pixelOffset(blockIndex);
    int coefficientBase = blockIndex * BLOCK_COEFFICIENTS;

    int tmp[64], src[8], dst[8];
    // Use x264's column-first order. Integer shifts make the pass order significant.
    for (int x = 0; x < 8; ++x) {
        for (int y = 0; y < 8; ++y) {
            int p = pixelBase + GROUP_SIDE*y + x;
            src[y] = int(blocks[block].sourcePixels[p]) - int(blocks[block].predictedPixels[p]);
        }
        forwardPass(src, dst);
        for (int y = 0; y < 8; ++y) tmp[8*y+x] = dst[y];
    }
    for (int y = 0; y < 8; ++y) {
        for (int x = 0; x < 8; ++x) src[x] = tmp[8*y+x];
        forwardPass(src, dst);
        for (int x = 0; x < 8; ++x) blocks[block].transformed[coefficientBase + 8*x+y] = dst[x];
    }

    // dctcoef is signed 16-bit in the upstream 8-bit build. Keep the
    // same narrowing at the DC rounding step and after the first pass.
    for (int y = 0; y < 8; ++y) {
        for (int x = 0; x < 8; ++x) src[x] = blocks[block].inverseCoefficients[coefficientBase + 8*x+y];
        if (y == 0) src[0] = signed16(src[0] + 32);
        inversePass(src, dst);
        for (int x = 0; x < 8; ++x) {
            tmp[8*x+y] = signed16(dst[x]);
            blocks[block].inverseCoefficients[coefficientBase + 8*x+y] = tmp[8*x+y];
        }
    }
    for (int x = 0; x < 8; ++x) {
        for (int y = 0; y < 8; ++y) src[y] = tmp[8*x+y];
        inversePass(src, dst);
        for (int y = 0; y < 8; ++y) {
            int p = pixelBase + GROUP_SIDE*y + x;
            blocks[block].reconstructed[p] =
                uint(clamp(int(blocks[block].predictedPixels[p]) + (dst[y] >> 6), 0, 255));
        }
    }
}
