// Parallel CABAC bin generator.
//
// CABAC's arithmetic coder is serial, but the bin sequence it consumes depends
// only on the macroblock syntax, which is fully independent per macroblock.
// This pass derives every bin for the picture in parallel and stores it as a
// compact descriptor that a single serial coder (on the host) replays.
//
// pass 0: one invocation per macroblock writes its bins into a fixed-stride
//         slot and records the exact bin count.
// pass 1: one invocation prefix-sums the counts into dense offsets.
// pass 2: one invocation per macroblock compacts the used bins.
//
// Bin descriptors:
//   < 0x40000000  context decision: (index << 1) | bit
//   < 0x80000000  bypass:           0x40000000 | bit
//   < 0xC0000000  bypass ue:        0x80000000 | (expBits << 28) | value
//   == 0xC0000000 terminal
//   >= 0xE0000000 flush:            0xE0000000 | (frame & 31)
#version 450
#extension GL_GOOGLE_include_directive : require
#include "macroblock4_order.glsl"
#include "mv_predict_math.glsl"
layout(local_size_x = 64) in;

#ifndef CABAC_MAX_OPERATIONS
#define CABAC_MAX_OPERATIONS 8192
#endif
#ifndef CABAC_RESIDUAL_WORDS
#define CABAC_RESIDUAL_WORDS 3227648
#endif
#ifndef CABAC_MAX_BYTES
#define CABAC_MAX_BYTES 2097152
#endif
#ifndef CABAC_BIN_STRIDE
#define CABAC_BIN_STRIDE 1024
#endif
#ifndef CABAC_MAX_BINS
#define CABAC_MAX_BINS 524288
#endif
const int maxBytes = CABAC_MAX_BYTES;
const uint binStride = uint(CABAC_BIN_STRIDE), binCapacity = uint(CABAC_MAX_BINS);

struct Operation { int kind, first, second; };
struct Fixture {
    int qp, model, chroma444, frame, count, finish;
    Operation operations[CABAC_MAX_OPERATIONS];
    int coefficients[64];
    uint context[1024];
    uint bytes[maxBytes];
    int low, range, queue, outstanding, position, effectiveQp, mvdMagnitude;
};
layout(std430, binding = 0) buffer Corpus {
    int contextInit[4][1024][2];
    int rangeLps[64][4];
    int transition[128][2];
    int renormShift[64];
    int significantBase[2][16], lastBase[2][16], levelBase[16], countMinusOne[14];
    int significant8x8[2][64], last8x8[63], significance422[7];
    int residualBank[CABAC_RESIDUAL_WORDS];
    Fixture fixtures[];
};
layout(std430, binding = 1) buffer SparseBins { uint sparseBins[]; };
// meta[0..count) counts, meta[count] total, meta[count+1..] dense offsets.
layout(std430, binding = 2) buffer Meta { uint meta[]; };
layout(std430, binding = 3) buffer DenseBins { uint denseBins[]; };
layout(push_constant) uniform Push { uint pass; } pc;

uint binBase, binCount;

void pushBin(uint value) {
    if (binCount < binStride) sparseBins[binBase+binCount] = value;
    ++binCount;
}
void emitDecision(int f, int index, int bit) { pushBin((uint(index) << 1) | uint(bit & 1)); }
void emitBypass(int f, int bit) { pushBin(0x40000000u | uint(bit & 1)); }
void emitUeBypass(int f, int expBits, int value) {
    pushBin(0x80000000u | (uint(expBits & 3) << 28) | (uint(value) & 0x0fffffffu));
}
void emitTerminal(int f) { pushBin(0xc0000000u); }
void emitFlush(int f, int frame) { pushBin(0xe0000000u | uint(frame & 31)); }

#include "cabac_syntax.glsl"

void main() {
    const uint count = uint(fixtures[0].count);
    const uint index = gl_GlobalInvocationID.x;
    if (pc.pass == 0u) {
        if (index >= count) return;
        binBase = index*binStride;
        binCount = 0;
        const int width = fixtures[0].chroma444;
        const int position = (width << 16) | int(index);
        if (fixtures[0].model != 0) encodeInter16Macroblock(0, 0, position);
        else encodeIntra16Macroblock(0, 0, position, fixtures[0].frame);
        meta[index] = binCount;
    } else if (pc.pass == 1u) {
        if (gl_LocalInvocationID.x != 0u) return;
        uint total = 0;
        for (uint i = 0; i < count; ++i) {
            meta[count+1+i] = total;
            total += min(meta[i], binStride);
        }
        meta[count] = min(total, binCapacity);
    } else {
        if (index >= count) return;
        const uint source = index*binStride, target = meta[count+1+index];
        const uint length = min(meta[index], binStride);
        for (uint i = 0; i < length && target+i < binCapacity; ++i)
            denseBins[target+i] = sparseBins[source+i];
    }
}
