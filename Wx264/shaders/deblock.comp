#version 450
#extension GL_GOOGLE_include_directive : require
#define WX_RECONSTRUCTION_ACCESS coherent
#include "layout.glsl"
#include "transform.glsl"
#include "deblock_tables.glsl"

layout(local_size_x=32) in;
#define WX_DEBLOCK_TILES 1
#include "deblock_filter.glsl"

void main() {
    uint slice = gl_WorkGroupID.x;
    int lane = int(gl_LocalInvocationID.x);
    int qp = frameQp();
    bool aq = pictureAq();
    if (qp < 16 && !aq) return;
    if (lane == 0) {
        thresholds[0] = deblockThresholds[qp];
        thresholds[1] = deblockThresholds[chromaQp(qp)];
    }
    bool intra = idr();
    int plane = lane < 16 ? 0 : (lane < 24 ? 1 : 2);
    int along = lane - (plane == 0 ? 0 : 8 * (plane + 1));
    uint first = firstMb(slice), count = sliceLength(slice);
    for (uint i = 0u; i < count; ++i) {
        uint mb = first + i;
        bool left = leftAvailable(mb, i), top = topAvailable(i);
        if (aq && lane < 3) prepareEdgeThreshold(mb, lane, left, top);
        bool rightInSlice = i + 1u < count && (mb + 1u) % pc.mbWidth != 0u;
        if (top && !left) {
            memoryBarrierBuffer();
            barrier();
        }
        // The same lane stages and publishes each packed word. Keep the previous
        // macroblock's rightmost word per row in the tile until filtering its border.
        if (left) {
            int leftWord = tileIndex(plane, -4, along);
            int right = tileIndex(plane, plane == 0 ? 12 : 4, along);
            for (int x = 0; x < 4; ++x) tile[leftWord+x] = tile[right+x];
        }
        barrier();
        for (int word = lane; word < 96; word += 32) {
            int component = word < 64 ? 0 : (word < 80 ? 1 : 2);
            int columns = component == 0 ? 4 : 2;
            int y = (word % (columns * columns * 4)) / columns;
            int x = (word % columns) * 4;
            loadWord(mb, component, x, y);
        }
        // These rows were vertically and horizontally filtered while processing
        // the preceding macroblock row. No other slice owns these words.
        int topPlane = lane < 16 ? 0 : (lane < 24 ? 1 : 2);
        int topColumns = topPlane == 0 ? 4 : 2;
        int topWord = lane - (topPlane == 0 ? 0 : 8 * (topPlane + 1));
        int topX = (topWord % topColumns) * 4;
        int topY = topWord / topColumns - 4;
        if (top) loadWord(mb, topPlane, topX, topY);
        barrier();
        // A lane owns one complete scanline for each direction.
        for (int edge = left ? 0 : 1; edge < 4; ++edge)
            filterEdge(mb, plane, along, edge, true, intra);
        barrier();
        for (int edge = top ? 0 : 1; edge < 4; ++edge)
            filterEdge(mb, plane, along, edge, false, intra);
        barrier();
        if (left) {
            int right = plane == 0 ? 12 : 4;
            reconstructed[reconWord(mb - 1u, plane, right, along)] = packWord(tileIndex(plane, -4, along));
        }
        if (top) reconstructed[reconWord(mb, topPlane, topX, topY)] = packWord(tileIndex(topPlane, topX, topY));
        for (int word = lane; word < 96; word += 32) {
            int component = word < 64 ? 0 : (word < 80 ? 1 : 2);
            int columns = component == 0 ? 4 : 2;
            int y = (word % (columns * columns * 4)) / columns;
            int col = word % columns;
            if (col != columns - 1 || !rightInSlice) {
                int x = col * 4;
                reconstructed[reconWord(mb, component, x, y)] = packWord(tileIndex(component, x, y));
            }
        }
        barrier();
    }
}
