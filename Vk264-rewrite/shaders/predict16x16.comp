#version 450
// 16x16 intra prediction: V / H / DC / DC_128.
// x264 common/predict.c:67-132 (predict_16x16_*_c).
layout(local_size_x = 1) in;

struct Block { int top[16]; int left[16]; int mode; int pred[256]; };
layout(std430, binding = 0) buffer Buf { Block blocks[]; };

void main()
{
    uint b = gl_GlobalInvocationID.x;
    int mode = blocks[b].mode;
    if (mode == 0) {
        for (int y = 0; y < 16; ++y)
            for (int x = 0; x < 16; ++x)
                blocks[b].pred[y*16+x] = blocks[b].top[x];
    } else if (mode == 1) {
        for (int y = 0; y < 16; ++y)
            for (int x = 0; x < 16; ++x)
                blocks[b].pred[y*16+x] = blocks[b].left[y];
    } else if (mode == 2) {
        int s = 16;
        for (int i = 0; i < 16; ++i)
            s += blocks[b].top[i] + blocks[b].left[i];
        int dc = s >> 5;
        for (int i = 0; i < 256; ++i) blocks[b].pred[i] = dc;
    } else {
        for (int i = 0; i < 256; ++i) blocks[b].pred[i] = 128;
    }
}
