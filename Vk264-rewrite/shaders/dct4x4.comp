#version 450
// 4x4 integer DCT. Direct translation of x264 common/dct.c:157 sub4x4_dct.
// One invocation per 4x4 block: reads src[16] and pred[16], writes dct[16].
layout(local_size_x = 1) in;

struct Block { int src[16]; int pred[16]; int dct[16]; };
layout(std430, binding = 0) buffer Buf { Block blocks[]; };

void main()
{
    uint b = gl_GlobalInvocationID.x;
    int diff[16];
    for (int i = 0; i < 16; ++i)
        diff[i] = blocks[b].src[i] - blocks[b].pred[i];

    int tmp[16];
    for (int i = 0; i < 4; ++i) {
        int s03 = diff[i*4+0] + diff[i*4+3];
        int s12 = diff[i*4+1] + diff[i*4+2];
        int d03 = diff[i*4+0] - diff[i*4+3];
        int d12 = diff[i*4+1] - diff[i*4+2];
        tmp[0*4+i] =  s03 +   s12;
        tmp[1*4+i] = 2*d03 +   d12;
        tmp[2*4+i] =  s03 -   s12;
        tmp[3*4+i] =  d03 - 2*d12;
    }
    for (int i = 0; i < 4; ++i) {
        int s03 = tmp[i*4+0] + tmp[i*4+3];
        int s12 = tmp[i*4+1] + tmp[i*4+2];
        int d03 = tmp[i*4+0] - tmp[i*4+3];
        int d12 = tmp[i*4+1] - tmp[i*4+2];
        blocks[b].dct[i*4+0] =  s03 +   s12;
        blocks[b].dct[i*4+1] = 2*d03 +   d12;
        blocks[b].dct[i*4+2] =  s03 -   s12;
        blocks[b].dct[i*4+3] =  d03 - 2*d12;
    }
}
